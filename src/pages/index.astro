    function setupPlaygroundModal(cardTriggerId, textTriggerId, modalId, closeBtnId, backdropId) {
      const cardTrigger = document.getElementById(cardTriggerId);
      const textTrigger = document.getElementById(textTriggerId);
      const modal = document.getElementById(modalId);
      const closeBtn = document.getElementById(closeBtnId);
      const backdrop = document.getElementById(backdropId);

      function open() {
        if (!modal) return;
        modal.classList.remove('opacity-0', 'pointer-events-none');
        const card = modal.querySelector('.relative.w-full.max-w-2xl');
        if (card) {
          card.classList.remove('scale-95');
          card.classList.add('scale-100');
        }
        document.body.style.overflow = 'hidden';
      }

      function close() {
        if (!modal) return;
        modal.classList.add('opacity-0', 'pointer-events-none');
        const card = modal.querySelector('.relative.w-full.max-w-2xl');
        if (card) {
          card.classList.remove('scale-100');
          card.classList.add('scale-95');
        }
        document.body.style.overflow = '';
      }

      if (cardTrigger) cardTrigger.addEventListener('click', open);
      if (textTrigger) textTrigger.addEventListener('click', open);
      if (closeBtn) closeBtn.addEventListener('click', close);
      if (backdrop) backdrop.addEventListener('click', close);

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal && !modal.classList.contains('pointer-events-none')) {
          close();
        }
      });
    }

    setupPlaygroundModal('open-playground-3', 'trigger-playground-3', 'pg-modal-3', 'close-pg-modal-3', 'pg-modal-backdrop-3');
    setupPlaygroundModal('open-playground-4', 'trigger-playground-4', 'pg-modal-4', 'close-pg-modal-4', 'pg-modal-backdrop-4');

    // Mobile scroll glitch protection for WebGL Voice Orb
    (() => {
      const orbContainer = document.getElementById('hero-orb-container');
      const playground = document.getElementById('playground');
      if (!orbContainer || !playground) return;

      const handleScroll = () => {
        const playgroundRect = playground.getBoundingClientRect();
        // If playground overlaps the viewport near top, hide orb
        if (playgroundRect.top < window.innerHeight * 0.45) {
          orbContainer.style.opacity = '0';
          orbContainer.style.visibility = 'hidden';
        } else {
          orbContainer.style.opacity = '1';
          orbContainer.style.visibility = 'visible';
        }
      };

      window.addEventListener('scroll', handleScroll, { passive: true });
      handleScroll();
    })();
  </script>

  <!-- Load voice-orb script -->
  <script src="/voice-orb.js" defer></script>
</MainLayout>
