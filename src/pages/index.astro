---
// Import the necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import AboutSection from '@components/sections/landing/AboutSection.astro';
import PublicationsSection from '@components/sections/landing/PublicationsSection.astro';
import SnapshotCarousel from '@components/ui/blocks/SnapshotCarousel.astro';
import FeaturedBlogSection from '@components/sections/landing/FeaturedBlogSection.astro';
---

<MainLayout>
  <div class="flex flex-col gap-16 md:gap-24 mb-16 md:mb-24">
    <HeroSection
      title=`Building intelligent software for <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-orange-600 dark:from-orange-300 dark:to-orange-500">what’s next</span>.`
      subTitle="We research, develop, and deploy next-generation software products with a distributed team of engineers and researchers."
      primaryBtn="Work with Us"
      primaryBtnURL="/contact"
      withReview={false}
      src="/assets/illustrations/Cool%20robot-rafiki.png"
      alt="R3ACTR Hero Image"
    />

    <AboutSection src="/assets/illustrations/Online%20tech%20talks-bro.png" />


    <SnapshotCarousel />

    <HeroSection
      title=`Write Smarter. Format Automatically with <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-orange-600 dark:from-orange-300 dark:to-orange-500">Paper Lab</span>.`
      subTitle="Built for academics and professionals. Paper Lab combines the ease of a rich-text WYSIWYG editor with the power of Python-based templating and LaTeX compilation. Focus on your research, not your references."
      primaryBtn="Launch Paper Lab"
      primaryBtnURL="https://paperlab.r3actr.work/"
      withReview={false}
      src="/assets/illustrations/Online%20document-pana%20(1).png"
      alt="Paper Lab Illustration"
    />

    <HeroSectionAlt
      title=`Open <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-orange-600 dark:from-orange-300 dark:to-orange-500">Source Quest</span>`
      subTitle="Open Source Quest is a structured, month-long open-source contribution program designed to help students gain real-world experience with professional software development workflows.<br/><br/>Participants work individually on curated, domain-specific GitHub repositories under guided mentorship. The program focuses on understanding how real open-source projects function—through issues, pull requests, reviews, and consistent contributions—rather than competitive coding or short-term hackathons."
      url="https://github.com/R3ACTR"
      images={[
        "/assets/others/osq.webp",
        "/assets/others/osq1.png",
        "/assets/others/osq3.png"
      ]}
    />

    <FeaturedBlogSection />

    <PublicationsSection />
  </div>
</MainLayout>
