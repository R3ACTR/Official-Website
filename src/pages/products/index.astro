---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';

const pageTitle: string = `Products | ${SITE.title}`;
const metaDescription =
  'Explore KTU Hub, PaperLab, and other innovative software products engineered by R3ACTR.';
const ogTitle = 'Products & Ecosystem | R3ACTR';

const products = [
  {
    title: 'KTU Hub',
    badge: 'Flagship Platform',
    badgeType: 'orange',
    tagline: 'The unified academic ecosystem for university students.',
    description:
      'Engineered specifically for KTU students to deliver essential course materials, real-time syllabus updates, question banks, and productivity tools directly into a fast, mobile-first experience.',
    image: '/assets/illustrations/Studying-amico.png',
    alt: 'KTU Hub Platform',
    features: [
      'Centralized Academic Resources',
      'Real-Time Syllabus & Exam Updates',
      'Fast & Mobile-Optimized Interface',
    ],
    primaryBtn: 'Launch KTU Hub',
    primaryUrl: 'https://www.ktuhub.site/',
    isExternal: true,
  },
  {
    title: 'PaperLab',
    badge: 'Academic Tool',
    badgeType: 'orange',
    tagline: 'Academic reports & IEEE papers, formatted automatically.',
    description:
      'Writing university seminar/project reports and IEEE conference papers without the formatting nightmare. PaperLab auto-formats margins, citations, equations, and university-approved certificate pages.',
    image: '/assets/illustrations/Thesis-bro.png',
    alt: 'PaperLab Tool',
    features: [
      'Auto-formats Margins & Citations',
      'University-Approved Certificate Pages',
      'Real-Time Live Formatting Feedback',
    ],
    primaryBtn: 'Launch PaperLab',
    primaryUrl: 'https://paperlab.r3actr.work/',
    isExternal: true,
  },
];
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    {/* Header Section */}
    <div class="text-center max-w-2xl mx-auto mb-10 lg:mb-12">
      <div class="inline-flex items-center gap-x-2 rounded-full border border-orange-500/30 bg-orange-500/10 px-3.5 py-1 text-xs font-bold tracking-widest text-orange-600 dark:border-orange-400/30 dark:bg-orange-400/10 dark:text-orange-400 uppercase mb-3">
        <span class="flex h-1.5 w-1.5 rounded-full bg-orange-500"></span>
        Ecosystem & Platforms
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-neutral-800 dark:text-neutral-200 tracking-tight">
        Engineered for <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-orange-600 dark:from-orange-300 dark:to-orange-500">Real Impact</span>
      </h1>
      <p class="mt-3 text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Discover the software products, academic tools, and applications researched and built by the R3ACTR team.
      </p>
    </div>

    {/* Products Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
      {
        products.map((product) => (
          <div class="group relative flex flex-col justify-between rounded-2xl border border-neutral-300 bg-white p-5 sm:p-6 transition-colors duration-200 hover:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-900 dark:hover:border-neutral-600">
            <div>
              {/* Product Header / Badge */}
              <div class="flex items-center justify-between gap-3 mb-4">
                <span class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider ${
                  product.badgeType === 'orange'
                    ? 'border border-orange-500/30 bg-orange-50 text-orange-600 dark:border-orange-400/30 dark:bg-orange-950/40 dark:text-orange-400'
                    : 'border border-neutral-300 bg-neutral-100 text-neutral-700 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300'
                }`}>
                  <span class={`h-1.5 w-1.5 rounded-full ${
                    product.badgeType === 'orange' ? 'bg-orange-500' : 'bg-neutral-400'
                  }`}></span>
                  {product.badge}
                </span>

                <span class="text-[11px] font-mono text-neutral-400 dark:text-neutral-500">
                  {new URL(product.primaryUrl).hostname.replace('www.', '')}
                </span>
              </div>

              {/* Illustration Showcase */}
              <div class="relative mb-5 flex h-36 sm:h-40 w-full items-center justify-center rounded-xl bg-neutral-100 p-4 dark:bg-neutral-800/60">
                <img
                  src={product.image}
                  alt={product.alt}
                  class="h-full w-full object-contain"
                  draggable="false"
                  loading="lazy"
                />
              </div>

              {/* Title & Tagline */}
              <h2 class="text-xl sm:text-2xl font-bold text-neutral-800 dark:text-neutral-200 tracking-tight">
                {product.title}
              </h2>
              <p class="mt-0.5 text-xs font-semibold text-orange-600 dark:text-orange-400">
                {product.tagline}
              </p>

              {/* Description */}
              <p class="mt-2.5 text-xs sm:text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
                {product.description}
              </p>

              {/* Features List */}
              <ul class="mt-4 space-y-1.5">
                {product.features.map((feature) => (
                  <li class="flex items-center gap-2 text-xs font-medium text-neutral-700 dark:text-neutral-300">
                    <div class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-orange-500/10 text-orange-600 dark:bg-orange-400/10 dark:text-orange-400">
                      <svg class="h-2.5 w-2.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12" />
                      </svg>
                    </div>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>

            {/* Action Button */}
            <div class="mt-6 pt-4 border-t border-neutral-200 dark:border-neutral-800">
              <a
                href={product.primaryUrl}
                target={product.isExternal ? '_blank' : '_self'}
                rel={product.isExternal ? 'noopener noreferrer' : undefined}
                class="group/btn inline-flex w-full items-center justify-center gap-x-2 rounded-lg bg-orange-500 px-4 py-2.5 text-xs sm:text-sm font-bold text-white transition-colors duration-200 hover:bg-orange-600 dark:bg-orange-500 dark:hover:bg-orange-600"
              >
                <span>{product.primaryBtn}</span>
                <svg
                  class="h-3.5 w-3.5 transition-transform duration-200 group-hover/btn:translate-x-1"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        ))
      }
    </div>

    {/* Bottom Callout Banner */}
    <div class="rounded-2xl border border-neutral-300 bg-white p-6 sm:p-8 text-center dark:border-neutral-700 dark:bg-neutral-900">
      <h3 class="text-xl sm:text-2xl font-bold text-neutral-800 dark:text-neutral-200 tracking-tight">
        Have a project or platform in mind?
      </h3>
      <p class="mt-2 text-neutral-600 dark:text-neutral-400 max-w-lg mx-auto text-xs sm:text-sm">
        We partner with teams, researchers, and creators to engineer intelligent digital products from scratch.
      </p>
      <div class="mt-4 flex justify-center">
        <a
          href="/contact"
          class="inline-flex items-center gap-x-2 rounded-lg bg-neutral-900 px-6 py-2.5 text-xs sm:text-sm font-bold text-white transition-colors duration-200 hover:bg-neutral-800 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200"
        >
          Work With Us
          <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</MainLayout>
