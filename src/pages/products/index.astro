---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';

const pageTitle: string = `Products | ${SITE.title}`;
const metaDescription =
  'Explore KTU Hub and other innovative products developed by R3ACTR.';
const ogTitle = 'Products | R3ACTR';
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
>
  {/* Header Section */}
  <div
    class="mx-auto max-w-[85rem] px-4 py-12 text-center sm:px-6 lg:px-8 lg:py-16"
  >
    <h1
      class="text-4xl font-extrabold tracking-tight text-neutral-800 md:text-5xl dark:text-neutral-200"
    >
      Our <span
        class="bg-gradient-to-r from-orange-400 to-orange-600 bg-clip-text text-transparent dark:from-orange-300 dark:to-orange-500"
        >Products</span
      >
    </h1>
    <p
      class="mx-auto mt-4 max-w-2xl text-lg text-neutral-600 dark:text-neutral-400"
    >
      Discover the platforms and solutions engineered by R3ACTR. We build
      products designed for scale, performance, and real-world impact.
    </p>
  </div>

  {/* Flagship Product: KTU Hub Showcase */}
  <div class="mx-auto mb-24 max-w-[85rem] px-4 sm:px-6 lg:px-8">
    <div
      class="relative overflow-hidden rounded-[3rem] border border-neutral-200/50 bg-white/40 shadow-2xl shadow-orange-500/5 backdrop-blur-xl dark:border-neutral-700/50 dark:bg-neutral-800/20"
    >
      <div
        class="relative z-10 grid items-center gap-12 p-8 sm:p-12 lg:grid-cols-2 lg:p-16"
      >
        {/* Left: Text Content */}
        <div class="flex flex-col justify-center">
          <div
            class="mb-6 inline-flex w-fit items-center gap-x-2 rounded-full border border-orange-500/30 bg-orange-500/10 px-4 py-2 text-sm font-bold tracking-widest text-orange-600 uppercase dark:border-orange-400/30 dark:bg-orange-400/10 dark:text-orange-400"
          >
            <span class="flex h-2 w-2 animate-pulse rounded-full bg-orange-500"
            ></span>
            Flagship Platform
          </div>

          <h2
            class="mb-6 text-4xl font-extrabold tracking-tight text-neutral-800 sm:text-5xl lg:text-6xl dark:text-neutral-200"
          >
            KTU Hub
          </h2>

          <p
            class="mb-8 text-lg leading-relaxed text-neutral-600 dark:text-neutral-400"
          >
            The premier academic platform designed specifically for KTU
            students. We've engineered a unified ecosystem to seamlessly deliver
            essential resources, real-time updates, and powerful tools directly
            to your fingertips.
          </p>

          <ul class="mb-10 space-y-4">
            {
              [
                'Centralized Academic Resources & Materials',
                'Real-Time Notifications & Syllabus Updates',
                'Intuitive, Fast, and Mobile-Optimized Experience',
              ].map(feature => (
                <li class="flex items-start gap-3 font-medium text-neutral-700 dark:text-neutral-300">
                  <div class="mt-0.5 flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-orange-500 text-white">
                    <svg
                      class="h-4 w-4"
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                  </div>
                  {feature}
                </li>
              ))
            }
          </ul>

          <a
            href="https://www.ktuhub.site/"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex w-fit items-center gap-x-3 rounded-full bg-gradient-to-r from-orange-500 to-orange-600 px-8 py-4 text-base font-bold text-white shadow-lg shadow-orange-500/30 transition-all duration-300 hover:scale-105 hover:shadow-orange-500/50"
          >
            Launch KTU Hub
            <svg
              class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1.5"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
            >
          </a>
        </div>

        {/* Right: Image */}
        <div class="relative flex items-center justify-center lg:justify-end">
          <img
            src="/assets/illustrations/Studying-amico.png"
            alt="KTU Hub Platform"
            class="w-full max-w-lg object-contain drop-shadow-2xl transition-transform duration-700 hover:scale-[1.02]"
            draggable="false"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    {/* Product 2: EPOQ Showcase */}
    <div
      class="relative mt-24 overflow-hidden rounded-[3rem] border border-neutral-200/50 bg-white/40 shadow-2xl shadow-orange-500/5 backdrop-blur-xl dark:border-neutral-700/50 dark:bg-neutral-800/20"
    >
      <div
        class="relative z-10 grid items-center gap-12 p-8 sm:p-12 lg:grid-cols-2 lg:p-16"
      >
        {/* Left: Image (Desktop) */}
        <div
          class="relative order-last flex items-center justify-center lg:order-first lg:justify-start"
        >
          <img
            src="/assets/illustrations/epoq.png"
            alt="EPOQ Repository"
            class="w-full max-w-lg object-contain drop-shadow-2xl transition-transform duration-700 hover:scale-[1.02]"
            draggable="false"
            loading="lazy"
          />
        </div>

        {/* Right: Text Content */}
        <div class="flex flex-col justify-center">
          <div
            class="mb-6 inline-flex w-fit items-center gap-x-2 rounded-full border border-neutral-500/30 bg-neutral-500/10 px-4 py-2 text-sm font-bold tracking-widest text-neutral-600 uppercase dark:border-neutral-400/30 dark:bg-neutral-400/10 dark:text-neutral-400"
          >
            <span class="flex h-2 w-2 rounded-full bg-neutral-500"></span>
            Open Source Project
          </div>

          <h2
            class="mb-6 text-4xl font-extrabold tracking-tight text-neutral-800 sm:text-5xl lg:text-6xl dark:text-neutral-200"
          >
            EPOQ
          </h2>

          <p
            class="mb-8 text-lg leading-relaxed text-neutral-600 dark:text-neutral-400"
          >
            EPOQ brings the power of deep learning to your desktop. Built with
            Tauri, Next.js, and PyTorch, this application provides a sleek,
            intuitive GUI for training state-of-the-art image classification
            models locally. Say goodbye to complex CLI scripts and hello to
            real-time visual feedback!
          </p>

          <ul class="mb-10 space-y-4">
            {
              [
                'Local Deep Learning Training',
                'Sleek Desktop GUI (Tauri + Next.js)',
                'Real-Time Visual Feedback',
              ].map(feature => (
                <li class="flex items-start gap-3 font-medium text-neutral-700 dark:text-neutral-300">
                  <div class="mt-0.5 flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-orange-500 text-white">
                    <svg
                      class="h-4 w-4"
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                  </div>
                  {feature}
                </li>
              ))
            }
          </ul>

          <a
            href="https://github.com/Sree14hari/EPOQ"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex w-fit items-center gap-x-3 rounded-full border border-neutral-300 bg-transparent px-8 py-4 text-base font-bold text-neutral-800 transition-all duration-300 hover:scale-105 hover:bg-neutral-100 dark:border-neutral-700 dark:text-neutral-200 dark:hover:bg-neutral-800"
          >
            View Repository
            <svg
              class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1.5"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M15 22v-4a4.8 4.8 0 0 0-1-3.24 10 10 0 0 0 7-6.76c0-4.64-3.56-5.4-5.4-5.4A8.25 8.25 0 0 0 12 2a8.25 8.25 0 0 0-3.56.6c-1.84 0-5.4.76-5.4 5.4 0 3.32 2.66 6.36 7 6.76a4.8 4.8 0 0 0-1 3.24v4"
              ></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg
            >
          </a>
        </div>
      </div>
    </div>

    {/* Product 3: PaperLab Showcase */}
    <div
      class="relative mt-24 overflow-hidden rounded-[3rem] border border-neutral-200/50 bg-white/40 shadow-2xl shadow-orange-500/5 backdrop-blur-xl dark:border-neutral-700/50 dark:bg-neutral-800/20"
    >
      <div
        class="relative z-10 grid items-center gap-12 p-8 sm:p-12 lg:grid-cols-2 lg:p-16"
      >
        {/* Left: Text Content */}
        <div class="flex flex-col justify-center">
          <div
            class="mb-6 inline-flex w-fit items-center gap-x-2 rounded-full border border-orange-500/30 bg-orange-500/10 px-4 py-2 text-sm font-bold tracking-widest text-orange-600 uppercase dark:border-orange-400/30 dark:bg-orange-400/10 dark:text-orange-400"
          >
            <span class="flex h-2 w-2 rounded-full bg-orange-500"></span>
            Academic Tool
          </div>

          <h2
            class="mb-6 text-4xl font-extrabold tracking-tight text-neutral-800 sm:text-5xl lg:text-6xl dark:text-neutral-200"
          >
            PaperLab
          </h2>

          <p
            class="mb-8 text-lg leading-relaxed text-neutral-600 dark:text-neutral-400"
          >
            <span
              class="mb-2 block font-bold text-neutral-800 dark:text-neutral-200"
              >Academic reports & IEEE papers, formatted perfectly.</span
            >
            Writing KTU seminar/project reports and IEEE conference papers shouldn't
            be a formatting nightmare. PaperLab auto-formats margins, citations, and
            university-approved certificate pages in real-time.
          </p>

          <ul class="mb-10 space-y-4">
            {
              [
                'Auto-formats Margins & Citations',
                'University-Approved Certificate Pages',
                'Real-Time Formatting Feedback',
              ].map(feature => (
                <li class="flex items-start gap-3 font-medium text-neutral-700 dark:text-neutral-300">
                  <div class="mt-0.5 flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-orange-500 text-white">
                    <svg
                      class="h-4 w-4"
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                  </div>
                  {feature}
                </li>
              ))
            }
          </ul>

          <a
            href="https://paperlab.r3actr.work/"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex w-fit items-center gap-x-3 rounded-full bg-gradient-to-r from-orange-500 to-orange-600 px-8 py-4 text-base font-bold text-white shadow-lg shadow-orange-500/30 transition-all duration-300 hover:scale-105 hover:shadow-orange-500/50"
          >
            Launch PaperLab
            <svg
              class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1.5"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
            >
          </a>
        </div>

        {/* Right: Image */}
        <div class="relative flex items-center justify-center lg:justify-end">
          <img
            src="/assets/illustrations/Thesis-bro.png"
            alt="PaperLab Tool"
            class="w-full max-w-lg object-contain drop-shadow-2xl transition-transform duration-700 hover:scale-[1.02]"
            draggable="false"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    {/* Coming Soon Note */}
    <div class="mt-16 text-center">
      <p
        class="text-sm font-medium tracking-widest text-neutral-500 uppercase dark:text-neutral-400"
      >
        More products in development
      </p>
    </div>
  </div>
</MainLayout>
