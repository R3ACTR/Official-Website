---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';

const pageTitle: string = `Log In | ${SITE.title}`;
const metaDescription = 'Log in to your R3ACTR account.';
const ogTitle = 'Log In | R3ACTR';
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
>
  <div class="grid min-h-[calc(100vh-200px)] grid-cols-1 lg:grid-cols-2 rounded-2xl overflow-hidden shadow-xl mt-8 mb-16 border border-neutral-200 dark:border-neutral-700">
    
    {/* Left Side: Brand & Illustration */}
    <div class="relative hidden flex-col items-center justify-center bg-neutral-100 dark:bg-neutral-800/50 lg:flex p-12">
      
      <div class="relative z-10 w-full max-w-lg">
        <a href="/" class="mb-12 inline-block text-3xl font-extrabold text-neutral-800 dark:text-neutral-200">
          R3ACTR<span class="text-orange-500">.</span>
        </a>
        
        <img
          src="/assets/illustrations/Secure login-pana.png"
          alt="Secure Login"
          class="w-full drop-shadow-2xl transition-transform duration-700 hover:scale-[1.02]"
          draggable="false"
          loading="lazy"
        />
        
        <div class="mt-12 text-center">
          <h2 class="text-2xl font-bold text-neutral-800 dark:text-neutral-200">Secure Access</h2>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">
            Log in to manage your AI models, SaaS deployments, and academic resources securely.
          </p>
        </div>
      </div>
    </div>

    {/* Right Side: Login Form */}
    <div class="flex items-center justify-center px-6 py-12 sm:px-12 lg:px-16 xl:px-24 bg-neutral-200 dark:bg-neutral-800">
      <div class="w-full max-w-md">
        
        <div class="text-center mb-10">
          <div class="mb-6 lg:hidden inline-flex items-center justify-center rounded-full border border-neutral-300 bg-neutral-100 p-3 text-neutral-800 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200">
            <svg class="h-8 w-8" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-neutral-800 dark:text-neutral-200 tracking-tight">
            Welcome Back
          </h1>
          <p class="mt-3 text-neutral-600 dark:text-neutral-400">
            Enter your credentials to access your workspace.
          </p>
        </div>

        <form id="login-form" class="space-y-6">
          <div id="error-message" class="hidden rounded-lg bg-red-100 p-3 text-sm text-red-700 dark:bg-red-500/10 dark:text-red-400"></div>
          
          <div>
            <label for="email" class="block text-sm font-medium text-neutral-800 dark:text-neutral-200 mb-2">Email Address</label>
            <input type="email" id="email" class="block w-full rounded-xl border border-neutral-300 bg-white/50 px-4 py-4 text-base outline-none transition-colors focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 dark:border-neutral-700 dark:bg-neutral-900/50 dark:text-neutral-300" placeholder="you@example.com" required>
          </div>

          <div>
            <div class="flex items-center justify-between mb-2">
              <label for="password" class="block text-sm font-medium text-neutral-800 dark:text-neutral-200">Password</label>
              <a class="text-sm font-medium text-orange-600 hover:text-orange-500 dark:text-orange-400 dark:hover:text-orange-300 transition-colors" href="#">Forgot password?</a>
            </div>
            <input type="password" id="password" class="block w-full rounded-xl border border-neutral-300 bg-white/50 px-4 py-4 text-base outline-none transition-colors focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 dark:border-neutral-700 dark:bg-neutral-900/50 dark:text-neutral-300" placeholder="••••••••" required>
          </div>

          <button type="submit" id="submit-btn" class="group w-full inline-flex justify-center items-center gap-x-2 rounded-xl bg-orange-500 px-4 py-4 text-base font-bold text-white shadow-md transition-all hover:bg-orange-600 focus:outline-none mt-4 disabled:opacity-70 disabled:cursor-not-allowed">
            Log in to Dashboard
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </button>
        </form>

        <div class="mt-10 text-center">
          <p class="text-sm text-neutral-600 dark:text-neutral-400">
            Don't have an account?
            <a class="font-medium text-orange-600 hover:text-orange-500 dark:text-orange-400 dark:hover:text-orange-300 transition-colors ml-1" href="#">
              Request access
            </a>
          </p>
        </div>
      </div>
    </div>
    
  </div>
</MainLayout>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/12.14.0/firebase-app.js";
  import { getAuth, signInWithEmailAndPassword, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/12.14.0/firebase-auth.js";
  import { getAnalytics } from "https://www.gstatic.com/firebasejs/12.14.0/firebase-analytics.js";

  const firebaseConfig = {
    apiKey: "AIzaSyCjAXaJTz6eemuhJTNgzZPiHHGE97ZWPpo",
    authDomain: "r3actr-work.firebaseapp.com",
    projectId: "r3actr-work",
    storageBucket: "r3actr-work.firebasestorage.app",
    messagingSenderId: "1022996885028",
    appId: "1:1022996885028:web:0b6d73baa82c6ffc0e32b1",
    measurementId: "G-F00QL9FL8J"
  };

  const app = initializeApp(firebaseConfig);
  const analytics = getAnalytics(app);
  const auth = getAuth(app);

  // If user is already logged in, redirect them to dashboard automatically
  onAuthStateChanged(auth, (user) => {
    if (user) {
      window.location.href = '/dashboard';
    }
  });

  const form = document.getElementById('login-form');
  const errorMsg = document.getElementById('error-message');
  const submitBtn = document.getElementById('submit-btn');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      if (errorMsg) errorMsg.classList.add('hidden');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = 'Signing in...';
      }

      const emailInput = form.querySelector('input[type="email"]');
      const passwordInput = form.querySelector('input[type="password"]');
      
      const email = emailInput ? emailInput.value.trim() : '';
      const password = passwordInput ? passwordInput.value : '';

      if (!email || !password) {
        if (errorMsg) {
          errorMsg.textContent = 'Please enter both your email and password.';
          errorMsg.classList.remove('hidden');
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = `
            Log in to Dashboard
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          `;
        }
        return;
      }

      try {
        await signInWithEmailAndPassword(auth, email, password);
        window.location.href = '/dashboard'; // Redirect to new dashboard
      } catch (error) {
        console.error(error);
        if (errorMsg) {
          // Provide friendlier messages for common errors
          if (error.code === 'auth/invalid-credential') {
            errorMsg.textContent = 'Invalid email or password. Please try again.';
          } else {
            errorMsg.textContent = 'Error: ' + error.message;
          }
          errorMsg.classList.remove('hidden');
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = `
            Log in to Dashboard
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          `;
        }
      }
    });
  }
</script>
