---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';

const pageTitle: string = `Terms & Conditions | ${SITE.title}`;
const metaDescription =
  'Read the Terms and Conditions for using R3ACTR platforms, digital products, and services.';
const ogTitle = 'Terms & Conditions | R3ACTR';

const sections = [
  {
    number: '01',
    title: 'Acceptance of Terms',
    content:
      'By accessing or using the websites, tools, and digital platforms provided by R3ACTR ("we", "our", or "us"), you agree to comply with and be bound by these Terms and Conditions.',
  },
  {
    number: '02',
    title: 'Platform Usage & Conduct',
    content:
      'Our platforms (including KTU Hub and PaperLab) are intended to assist students, researchers, and developers. You agree not to disrupt system availability, deploy scraping bots that degrade services, or misuse our infrastructure.',
  },
  {
    number: '03',
    title: 'Intellectual Property',
    content:
      'All proprietary software, brand assets, logos, and website designs are the exclusive property of R3ACTR. Unauthorized reproduction or rebranding without prior written consent is strictly prohibited.',
  },
  {
    number: '04',
    title: 'Open Source Licensing',
    content:
      'Code released under our public GitHub organization (github.com/R3ACTR) is governed by their respective open-source licenses (e.g. MIT, Apache 2.0). License conditions must be respected when reusing open code.',
  },
  {
    number: '05',
    title: 'Warranty Disclaimer',
    content:
      'All services and tools are provided on an "as is" and "as available" basis without express or implied warranties. While we strive for high uptime and accuracy, R3ACTR does not guarantee uninterrupted operation.',
  },
  {
    number: '06',
    title: 'Modifications & Contact',
    content:
      'We reserve the right to modify these terms as our platforms evolve. For inquiries regarding our terms, reach out to us at r3actr@gmail.com or via our Contact page.',
    isContact: true,
  },
];
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    {/* Header */}
    <div class="text-center max-w-2xl mx-auto mb-10 lg:mb-12">
      <div class="inline-flex items-center gap-x-2 rounded-full border border-orange-500/30 bg-orange-500/10 px-3.5 py-1 text-xs font-bold tracking-widest text-orange-600 dark:border-orange-400/30 dark:bg-orange-400/10 dark:text-orange-400 uppercase mb-3">
        <span class="flex h-1.5 w-1.5 rounded-full bg-orange-500"></span>
        Legal & Terms
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-neutral-800 dark:text-neutral-200 tracking-tight">
        Terms & <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-orange-600 dark:from-orange-300 dark:to-orange-500">Conditions</span>
      </h1>
      <p class="mt-3 text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Guidelines and rules governing the use of R3ACTR platforms, services, and software.
      </p>
    </div>

    {/* Terms Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16 items-stretch">
      {
        sections.map((sec) => (
          <div class="flex flex-col justify-between rounded-2xl border border-neutral-300 bg-white p-5 sm:p-6 dark:border-neutral-700 dark:bg-neutral-900 transition-colors duration-200 hover:border-neutral-400 dark:hover:border-neutral-600">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-mono font-bold text-orange-600 dark:text-orange-400">
                  {sec.number}
                </span>
                <span class="h-1.5 w-1.5 rounded-full bg-neutral-300 dark:bg-neutral-700"></span>
              </div>
              <h2 class="text-lg sm:text-xl font-bold text-neutral-800 dark:text-neutral-200 tracking-tight mb-2">
                {sec.title}
              </h2>
              <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                {sec.content}
              </p>
            </div>

            {sec.isContact && (
              <div class="mt-5 pt-4 border-t border-neutral-200 dark:border-neutral-800 flex items-center gap-3">
                <a
                  href="/contact"
                  class="inline-flex items-center gap-x-1.5 rounded-lg bg-orange-500 px-3.5 py-1.5 text-xs font-bold text-white transition-colors duration-200 hover:bg-orange-600"
                >
                  Contact Us
                  <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
                <a
                  href="mailto:r3actr@gmail.com"
                  class="text-xs font-semibold text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors"
                >
                  r3actr@gmail.com
                </a>
              </div>
            )}
          </div>
        ))
      }
    </div>

    {/* Bottom Callout */}
    <div class="rounded-2xl border border-neutral-300 bg-white p-6 sm:p-8 text-center dark:border-neutral-700 dark:bg-neutral-900">
      <h3 class="text-xl sm:text-2xl font-bold text-neutral-800 dark:text-neutral-200 tracking-tight">
        Have questions regarding our terms?
      </h3>
      <p class="mt-2 text-neutral-600 dark:text-neutral-400 max-w-lg mx-auto text-xs sm:text-sm">
        We are happy to answer any questions or discuss custom licensing and partnership agreements.
      </p>
      <div class="mt-4 flex justify-center">
        <a
          href="/contact"
          class="inline-flex items-center gap-x-2 rounded-lg bg-neutral-900 px-6 py-2.5 text-xs sm:text-sm font-bold text-white transition-colors duration-200 hover:bg-neutral-800 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200"
        >
          Get In Touch
          <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</MainLayout>
