---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';
import { coreTeam, type TeamMember } from '@data/team';

export function getStaticPaths() {
  return coreTeam.map((member) => ({
    params: { slug: member.slug },
    props: { member },
  }));
}

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;

const pageTitle = `${member.name} • ${member.title} | ${SITE.title} ID`;
const pageDescription = `Official R3ACTR Core Team Member ID for ${member.name}. ${member.role} in ${member.department}. ID: ${member.idNumber}.`;
const canonicalUrl = `https://r3actr.work/id/${member.slug}`;
---

<MainLayout
  title={pageTitle}
  customDescription={pageDescription}
  customOgTitle={`${member.name} | R3ACTR Core ID`}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: member.name,
    jobTitle: member.title,
    worksFor: {
      '@type': 'Organization',
      name: 'R3ACTR Innovations',
      url: 'https://r3actr.work',
    },
    url: canonicalUrl,
    image: `https://r3actr.work${member.avatar}`,
    sameAs: member.socials.map((s) => s.url),
    knowsAbout: member.skills,
  }}
>
  <div class="relative min-h-screen pt-20 sm:pt-28 md:pt-32 pb-24 sm:pb-36">
    {/* Breadcrumb Navigation */}
    <div class="mx-auto max-w-5xl px-4 sm:px-6 mb-6 sm:mb-8">
      <nav class="flex items-center gap-2 text-xs font-mono text-neutral-500 dark:text-neutral-400">
        <a href="/" class="hover:text-neutral-900 dark:hover:text-white transition-colors">HOME</a>
        <span>/</span>
        <a href="/id" class="hover:text-neutral-900 dark:hover:text-white transition-colors">TEAM</a>
        <span>/</span>
        <span class="text-orange-600 dark:text-orange-400 font-bold uppercase">{member.slug}</span>
      </nav>
    </div>

    {/* Main Grid: Badge on Left / Center + Dossier on Right */}
    <div class="mx-auto max-w-5xl px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      {/* LEFT COLUMN: MEMBER PHOTO */}
      <div class="lg:col-span-5 flex flex-col items-center">
        <div class="sticky top-24 w-full flex flex-col items-center max-w-[340px] sm:max-w-[360px]">
          {/* Framed Studio Portrait */}
          <div class="group relative w-full overflow-hidden rounded-[28px] border border-neutral-300 bg-neutral-100 shadow-xl transition-all duration-300 hover:shadow-2xl dark:border-neutral-800 dark:bg-neutral-900">
            <img
              src={member.avatar}
              alt={member.name}
              class="w-full aspect-[4/5] object-cover object-top transition-transform duration-500 group-hover:scale-[1.02]"
              loading="eager"
            />
          </div>

          {/* Social Icons Row */}
          <div class="mt-5 flex w-full items-center justify-center gap-4 sm:gap-5">
            {member.socials.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.platform}
                title={social.platform}
                class="flex h-11 w-11 items-center justify-center rounded-2xl border border-neutral-300 bg-white text-neutral-800 shadow-xs transition-all hover:-translate-y-0.5 hover:border-orange-500 hover:text-orange-600 hover:shadow-md active:scale-95 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100 dark:hover:border-orange-400 dark:hover:text-orange-400"
              >
                {social.platform === 'GitHub' && (
                  <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                  </svg>
                )}
                {social.platform === 'LinkedIn' && (
                  <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                    <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.59 1.59 0 0 0 0-3.18 1.59 1.59 0 0 0 0 3.18m1.4 9.74v-8.37H5.06v8.37h2.8z"/>
                  </svg>
                )}
                {social.platform === 'Website' && (
                  <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
                  </svg>
                )}
                {social.platform === 'Instagram' && (
                  <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
                )}
                {(social.platform === 'Twitter' || social.platform === 'Telegram') && (
                  <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                )}
              </a>
            ))}
          </div>

        </div>
      </div>

      {/* RIGHT COLUMN: MEMBER DOSSIER & PORTFOLIO */}
      <div class="lg:col-span-7 flex flex-col gap-6">
        
        {/* Executive Header Card */}
        <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 shadow-sm transition-colors duration-200">
          <div class="flex items-center justify-end">
            <span class="font-mono text-xs font-semibold text-neutral-500 dark:text-neutral-400">
              BADGE REF: {member.idNumber}
            </span>
          </div>

          <h1 class="mt-4 text-3xl sm:text-4xl font-extrabold text-neutral-900 dark:text-neutral-50 tracking-tight">
            {member.name}
          </h1>
          <p class="mt-1.5 text-base sm:text-lg font-semibold text-orange-500 dark:text-orange-400">
            {member.role} • {member.department}
          </p>

          <p class="mt-4 text-sm sm:text-base leading-relaxed text-neutral-700 dark:text-neutral-300">
            {member.bio}
          </p>

          {/* Skills & Interests */}
          {member.skills && member.skills.length > 0 && (
            <div class="mt-6 pt-6 border-t border-neutral-200 dark:border-neutral-800">
              <span class="block text-xs font-mono uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-semibold mb-5 sm:mb-6">
                Skills & Interests
              </span>
              <div class="flex flex-wrap gap-3 sm:gap-3.5">
                {member.skills.map((skill) => (
                  <span class="px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-xl text-xs sm:text-sm font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 border border-neutral-200 dark:border-neutral-700 transition-colors">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>

      </div>

    </div>
  </div>
</MainLayout>
