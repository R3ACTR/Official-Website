---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';
import { coreTeam } from '@data/team';

const pageTitle = `Core Team Directory & ID Registry | ${SITE.title}`;
const pageDescription =
  'Official registry and credentials for the R3ACTR Core Engineering, Research, and Systems Architecture team.';

const directoryStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'R3ACTR Core Team Directory & ID Registry',
  description: pageDescription,
  url: 'https://r3actr.work/id',
  itemListElement: coreTeam.map((member, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    item: {
      '@type': 'Person',
      name: member.name,
      jobTitle: member.title,
      url: `https://r3actr.work/id/${member.slug}`,
      image: member.avatar.startsWith('http') ? member.avatar : `https://r3actr.work${member.avatar}`,
      sameAs: member.socials.map((s) => s.url),
    },
  })),
};
---

<MainLayout
  title={pageTitle}
  customDescription={pageDescription}
  customOgTitle="Core Team ID Registry | R3ACTR"
  structuredData={directoryStructuredData}
>
  <div class="relative py-12 sm:py-16 md:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      {/* Header */}
      <div class="text-center max-w-2xl mx-auto">
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-50">
          Core Team <span class="text-orange-500 dark:text-orange-400">ID Registry</span>
        </h1>
        <p class="mt-3 text-base sm:text-lg text-neutral-600 dark:text-neutral-300">
          Cryptographically verifiable digital identification credentials for R3ACTR researchers, architects, and maintainers.
        </p>
      </div>

      {/* Directory Cards Grid: 2 cards in a row */}
      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        {coreTeam.map((member) => (
          <a
            href={`/id/${member.slug}`}
            class="group relative p-6 sm:p-7 rounded-3xl bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 hover:border-neutral-400 dark:hover:border-neutral-600 shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between"
          >
            <div>
              {/* Top Meta Bar */}
              <div class="flex items-center justify-between gap-2 border-b border-neutral-200 dark:border-neutral-800 pb-4">
                <span class="font-mono text-xs font-bold text-orange-600 dark:text-orange-400">
                  {member.idNumber}
                </span>
              </div>

              {/* Avatar & Names */}
              <div class="mt-5 flex items-center gap-4">
                <div class="relative w-16 h-16 rounded-2xl overflow-hidden border border-neutral-300 dark:border-neutral-700 bg-neutral-100 dark:bg-neutral-800 shrink-0">
                  <img
                    src={member.avatar}
                    alt={member.name}
                    class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-300"
                    loading="eager"
                  />
                </div>

                <div>
                  <h2 class="text-lg sm:text-xl font-bold text-neutral-900 dark:text-neutral-100 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors">
                    {member.name}
                  </h2>
                  <p class="text-xs sm:text-sm font-semibold text-orange-600 dark:text-orange-400">
                    {member.title}
                  </p>
                  <p class="text-[11px] text-neutral-500 dark:text-neutral-400 font-mono font-medium">
                    {member.department}
                  </p>
                </div>
              </div>

              {/* Bio snippet */}
              <p class="mt-4 text-xs sm:text-sm text-neutral-600 dark:text-neutral-300 line-clamp-2 leading-relaxed">
                {member.bio}
              </p>

              {/* Skills Tags */}
              <div class="mt-5 flex flex-wrap gap-2">
                {member.skills.slice(0, 4).map((skill) => (
                  <span class="px-2.5 py-1 rounded-lg text-[11px] font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 border border-neutral-200 dark:border-neutral-700">
                    {skill}
                  </span>
                ))}
              </div>
            </div>

            {/* Bottom CTA */}
            <div class="mt-6 pt-4 border-t border-neutral-200 dark:border-neutral-800 flex items-center justify-between text-xs sm:text-sm font-semibold text-orange-600 dark:text-orange-400 group-hover:translate-x-0.5 transition-transform">
              <span>View Profile & Credentials</span>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</MainLayout>
