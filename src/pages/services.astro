---
import MainLayout from '@/layouts/MainLayout.astro';
import FeaturesStatsAlt from '@components/sections/features/FeaturesStatsAlt.astro';
import { SITE } from '@data/constants';

const pageTitle: string = `Services | ${SITE.title}`;
const metaDescription =
  'Explore the innovative software development, research, and design services offered by R3ACTR.';
const ogTitle = 'Services | R3ACTR';

const services = [
  {
    title: 'AI & Web3 Development',
    subTitle: 'Leveraging cutting-edge artificial intelligence and decentralized technologies to build robust, future-proof applications. We design intelligent systems that learn, adapt, and scale securely.',
    img: '/assets/Custsection/Artificial%20intelligence-bro.png',
    imgAlt: 'AI and Web3 Development',
    isRight: true,
  },
  {
    title: 'SaaS Platforms & Web Apps',
    subTitle: 'From concept to deployment, we build highly scalable, user-centric SaaS platforms and web applications. Our tech stack is optimized for performance, security, and seamless user experiences.',
    img: '/assets/Custsection/Working-rafiki.png',
    imgAlt: 'SaaS Platforms',
    isRight: false,
  },
  {
    title: 'Research-Driven Projects',
    subTitle: 'Pushing the boundaries of what is possible. We partner with academic and industry leaders to prototype experimental technologies, conduct deep technical research, and build innovative proof-of-concepts.',
    img: '/assets/illustrations/Thesis-bro.png',
    imgAlt: 'Research Projects',
    isRight: true,
  },
  {
    title: 'Open Source & Mentorship',
    subTitle: 'We believe in giving back to the community. Through initiatives like Open Source Quest (OSQ), we mentor the next generation of developers while actively contributing to the open-source ecosystem.',
    img: '/assets/illustrations/Team%20work-cuate.svg',
    imgAlt: 'Open Source Mentorship',
    isRight: false,
  },
];
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
>
  {/* Header Section */}
  <div class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8 lg:py-16 text-center">
    <h1 class="text-4xl md:text-5xl font-extrabold text-neutral-800 dark:text-neutral-200 tracking-tight">
      Our <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-orange-600 dark:from-orange-300 dark:to-orange-500">Services</span>
    </h1>
    <p class="mt-4 text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto">
      Uniting deep technical expertise with visionary design to build solutions that scale.
    </p>
  </div>

  {/* Services Grid */}
  <div class="mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8 mb-24 grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
    {services.map((service) => (
      <div class="relative overflow-hidden rounded-[2.5rem] border border-neutral-200/50 bg-white/40 shadow-xl shadow-orange-500/5 backdrop-blur-xl dark:border-neutral-700/50 dark:bg-neutral-800/20 group flex flex-col p-8 sm:p-10 transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl hover:shadow-orange-500/10">

        {/* Image Top */}
        <div class="relative flex items-center justify-center h-48 sm:h-64 mb-8">
          <img
            src={service.img}
            alt={service.imgAlt}
            class="w-full h-full object-contain drop-shadow-lg transition-transform duration-700 group-hover:scale-105"
            draggable="false"
            loading="lazy"
          />
        </div>
        
        {/* Text Bottom */}
        <div class="flex flex-col flex-grow">
          <h2 class="text-2xl sm:text-3xl font-bold text-neutral-800 dark:text-neutral-200 tracking-tight mb-4 transition-colors group-hover:text-orange-500 dark:group-hover:text-orange-400">
            {service.title}
          </h2>
          <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
            {service.subTitle}
          </p>
        </div>
        
      </div>
    ))}
  </div>

  {/* Stats Section */}
  <div class="mb-24">
    <FeaturesStatsAlt
      title="By the Numbers"
      subTitle="Our commitment to quality, open-source innovation, and robust engineering is evident in every project we undertake."
      benefits={[
        '100+ Open Source Commits across repositories.',
        'Multiple highly-scalable platforms actively maintained.',
        'Dedicated mentorship for emerging student developers.',
      ]}
    />
  </div>

</MainLayout>
