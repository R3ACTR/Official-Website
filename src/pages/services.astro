---
import MainLayout from '@/layouts/MainLayout.astro';
import FeaturesStatsAlt from '@components/sections/features/FeaturesStatsAlt.astro';
import { SITE } from '@data/constants';

const pageTitle: string = `Services | ${SITE.title}`;
const metaDescription =
  'Explore the innovative software development, research, and design services offered by R3ACTR.';
const ogTitle = 'Services | R3ACTR';

const services = [
  {
    title: 'AI & Web3 Development',
    subTitle:
      'Leveraging cutting-edge artificial intelligence and decentralized technologies to build robust, future-proof applications. We design intelligent systems that learn, adapt, and scale securely.',
    img: '/assets/Custsection/Artificial%20intelligence-bro.png',
    imgAlt: 'AI and Web3 Development',
    isRight: true,
  },
  {
    title: 'SaaS Platforms & Web Apps',
    subTitle:
      'From concept to deployment, we build highly scalable, user-centric SaaS platforms and web applications. Our tech stack is optimized for performance, security, and seamless user experiences.',
    img: '/assets/Custsection/Working-rafiki.png',
    imgAlt: 'SaaS Platforms',
    isRight: false,
  },
  {
    title: 'Research-Driven Projects',
    subTitle:
      'Pushing the boundaries of what is possible. We partner with academic and industry leaders to prototype experimental technologies, conduct deep technical research, and build innovative proof-of-concepts.',
    img: '/assets/illustrations/Thesis-bro.png',
    imgAlt: 'Research Projects',
    isRight: true,
  },
  {
    title: 'Open Source & Mentorship',
    subTitle:
      'We believe in giving back to the community. Through initiatives like Open Source Quest (OSQ), we mentor the next generation of developers while actively contributing to the open-source ecosystem.',
    img: '/assets/illustrations/Team%20work-cuate.svg',
    imgAlt: 'Open Source Mentorship',
    isRight: false,
  },
];
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
>
  {/* Header Section */}
  <div
    class="mx-auto max-w-[85rem] px-4 py-12 text-center sm:px-6 lg:px-8 lg:py-16"
  >
    <h1
      class="text-4xl font-extrabold tracking-tight text-neutral-800 md:text-5xl dark:text-neutral-200"
    >
      Our <span
        class="bg-gradient-to-r from-orange-400 to-orange-600 bg-clip-text text-transparent dark:from-orange-300 dark:to-orange-500"
        >Services</span
      >
    </h1>
    <p
      class="mx-auto mt-4 max-w-2xl text-lg text-neutral-600 dark:text-neutral-400"
    >
      Uniting deep technical expertise with visionary design to build solutions
      that scale.
    </p>
  </div>

  {/* Services Grid */}
  <div
    class="mx-auto mb-24 grid max-w-[85rem] grid-cols-1 gap-8 px-4 sm:px-6 md:grid-cols-2 lg:gap-12 lg:px-8"
  >
    {
      services.map(service => (
        <div class="group relative flex flex-col overflow-hidden rounded-[2.5rem] border border-neutral-200/50 bg-white/40 p-8 shadow-xl shadow-orange-500/5 backdrop-blur-xl transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl hover:shadow-orange-500/10 sm:p-10 dark:border-neutral-700/50 dark:bg-neutral-800/20">
          {/* Image Top */}
          <div class="relative mb-8 flex h-48 items-center justify-center sm:h-64">
            <img
              src={service.img}
              alt={service.imgAlt}
              class="h-full w-full object-contain drop-shadow-lg transition-transform duration-700 group-hover:scale-105"
              draggable="false"
              loading="lazy"
            />
          </div>

          {/* Text Bottom */}
          <div class="flex flex-grow flex-col">
            <h2 class="mb-4 text-2xl font-bold tracking-tight text-neutral-800 transition-colors group-hover:text-orange-500 sm:text-3xl dark:text-neutral-200 dark:group-hover:text-orange-400">
              {service.title}
            </h2>
            <p class="text-base leading-relaxed text-neutral-600 dark:text-neutral-400">
              {service.subTitle}
            </p>
          </div>
        </div>
      ))
    }
  </div>

  {/* Stats Section */}
  <div class="mb-24">
    <FeaturesStatsAlt
      title="By the Numbers"
      subTitle="Our commitment to quality, open-source innovation, and robust engineering is evident in every project we undertake."
      benefits={[
        '100+ Open Source Commits across repositories.',
        'Multiple highly-scalable platforms actively maintained.',
        'Dedicated mentorship for emerging student developers.',
      ]}
    />
  </div>
</MainLayout>
