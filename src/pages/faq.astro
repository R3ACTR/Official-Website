---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';

const pageTitle: string = `FAQ | ${SITE.title}`;
const metaDescription =
  'Find answers to frequently asked questions about R3ACTR, our software products, client services, research, and open-source initiatives.';
const ogTitle = 'Frequently Asked Questions | R3ACTR';

const faqCategories = [
  {
    category: 'About R3ACTR',
    description: 'Our mission, structure, and operational approach.',
    questions: [
      {
        question: 'What is R3ACTR?',
        answer:
          'R3ACTR is an engineering and research organization that turns real-world problems into software products. We research, design, and engineer technology across AI, SaaS, Web3, and digital platforms — with a focus on building products that are genuinely useful.',
      },
      {
        question: 'What core technologies and domains do you focus on?',
        answer:
          'Our core technical domains include Artificial Intelligence (machine learning, vision models, edge LLM systems), Modern Web & SaaS development (full-stack TypeScript, Astro, Next.js, Rust/Tauri), Decentralized Web3 technologies, and Academic/Scientific computing tools.',
      },
      {
        question: 'How is the R3ACTR team structured?',
        answer:
          'We operate as a distributed team of specialized software engineers, researchers, and designers collaborating globally to build open-source tools, consumer platforms, and research-backed software solutions.',
      },
    ],
  },
  {
    category: 'Products & Platforms',
    description: 'Active software platforms, editors, and developer tools.',
    questions: [
      {
        question: 'What is PaperLab?',
        answer:
          'PaperLab (paperlab.r3actr.com) is a modern academic and research document editor. It automates margins, citations, university-approved certificate pages, and IEEE paper formatting in real-time, removing formatting headaches for students and researchers.',
      },
      {
        question: 'What is KTU Hub?',
        answer:
          'KTU Hub (ktuhub.site) is our flagship academic platform designed specifically for university students. It provides centralized course materials, real-time syllabus updates, previous question banks, and productivity tools in a fast, mobile-friendly interface.',
      },
      {
        question: 'Are R3ACTR products free to use?',
        answer:
          'Yes, our primary student and community platforms like KTU Hub and PaperLab are publicly accessible and free to use for students, educators, and researchers.',
      },
    ],
  },
  {
    category: 'Services & Collaboration',
    description: 'Working with us on custom software, AI, and research projects.',
    questions: [
      {
        question: 'How can we work with R3ACTR on a custom project?',
        answer:
          'You can contact us directly through our Contact page (/contact) or email us with your project details. We collaborate with startups, enterprises, academic labs, and institutions to design and build custom software from scratch.',
      },
      {
        question: 'What kind of client projects do you take on?',
        answer:
          'We engineer custom SaaS platforms, AI/ML pipelines, high-performance web applications, and research prototypes. We handle everything from system architecture and UI/UX design to full-stack implementation and deployment.',
      },
      {
        question: 'What is your typical development process?',
        answer:
          'We follow an agile, iterative workflow: starting with problem discovery and technical architecture, followed by rapid prototyping, rigorous testing, and continuous deployment with transparent progress updates.',
      },
    ],
  },
  {
    category: 'Open Source & Community',
    description: 'Contributing and participating in our open programs.',
    questions: [
      {
        question: 'What is Open Source Quest (OSQ)?',
        answer:
          'Open Source Quest is a structured, month-long open-source contribution program designed to help students and developers gain real-world experience with professional development workflows, pull request reviews, and guided mentorship on production repositories.',
      },
      {
        question: 'Where can I find your open-source code?',
        answer:
          'All our public repositories, tools, and open-source initiatives are hosted on GitHub at github.com/R3ACTR. We welcome contributions, feature suggestions, and issues from the developer community.',
      },
    ],
  },
];

const allQuestions = faqCategories.flatMap((c) => c.questions);
const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allQuestions.map((q) => ({
    '@type': 'Question',
    name: q.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: q.answer,
    },
  })),
};
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={faqStructuredData}
>
  <div class="relative w-full bg-white text-neutral-900 font-sans min-h-[calc(100vh-200px)]">
    <section class="relative w-full px-4 sm:px-6 lg:px-8 pt-12 sm:pt-16 pb-20 sm:pb-28">
      <div class="mx-auto max-w-5xl">

        <!-- Back to Home -->
        <a
          href="/"
          class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-neutral-500 hover:text-neutral-900 transition-colors mb-8 group"
        >
          <span class="transition-transform group-hover:-translate-x-1">&larr;</span>
          <span>Back to Home</span>
        </a>

        <!-- Header -->
        <div class="mb-12 sm:mb-16">
          <span class="inline-block text-xs font-mono font-semibold uppercase tracking-wider text-neutral-500 mb-2">
            Frequently Asked Questions
          </span>
          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-neutral-900 leading-[1.08] mb-4 font-sans">
            Questions? We've got <br class="hidden sm:inline" />
            <span
              class="font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-[#4f46e5] via-[#7c3aed] to-[#a855f7]"
              style="background-image: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #a855f7 100%), url('/gradients/tvqokiltm5q-Agents-BG.webp'); background-size: cover; background-blend-mode: overlay; filter: contrast(1.15);"
            >
              answers
            </span>.
          </h1>
          <p class="text-base sm:text-lg text-neutral-600 font-sans max-w-2xl leading-relaxed">
            Everything you need to know about R3ACTR, our software products, research initiatives, and client collaboration.
          </p>
        </div>

        <!-- FAQ Categories & Accordions Grid -->
        <div class="space-y-12 sm:space-y-16 mb-16">
          {
            faqCategories.map((cat) => (
              <div>
                <!-- Category Heading -->
                <div class="mb-5 pb-3 border-b border-neutral-200">
                  <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-900 font-sans">
                    {cat.category}
                  </h2>
                  <p class="text-xs sm:text-sm text-neutral-500 mt-1 font-sans">
                    {cat.description}
                  </p>
                </div>

                <!-- Clean Accordions List -->
                <div class="divide-y divide-neutral-200/80">
                  {cat.questions.map((faq) => (
                    <details class="group py-4 sm:py-5 cursor-pointer">
                      <summary class="flex items-center justify-between font-semibold text-neutral-900 text-base sm:text-lg hover:text-neutral-600 transition-colors list-none">
                        <span>{faq.question}</span>
                        <span class="ml-4 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-neutral-100 text-neutral-600 transition-transform duration-200 group-open:rotate-45">
                          +
                        </span>
                      </summary>
                      <p class="mt-3 text-sm sm:text-base text-neutral-600 leading-relaxed max-w-3xl pr-6 font-sans">
                        {faq.answer}
                      </p>
                    </details>
                  ))}
                </div>
              </div>
            ))
          }
        </div>

        <!-- Still Have Questions? Callout Card -->
        <div class="p-8 sm:p-10 rounded-[28px] sm:rounded-[32px] bg-neutral-50 border border-neutral-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
          <div>
            <h3 class="text-xl sm:text-2xl font-bold text-neutral-900 font-sans mb-1.5">
              Still have questions?
            </h3>
            <p class="text-sm text-neutral-600 font-sans max-w-xl">
              Can’t find what you’re looking for? Reach out to our team directly and we’ll be glad to help.
            </p>
          </div>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-neutral-900 text-white font-sans text-sm font-semibold hover:bg-neutral-800 transition-all hover:gap-2.5 shrink-0"
          >
            <span>Contact Us</span>
            <span>&rarr;</span>
          </a>
        </div>

      </div>
    </section>
  </div>
</MainLayout>
