---
// Import layout and team data
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';

const pageTitle = `The Squad | ${SITE.title}`;
const pageDescription =
  'Meet the engineers, architects, and researchers building intelligent software and autonomous systems at R3ACTR Innovations.';
---

<MainLayout title={pageTitle} customDescription={pageDescription}>
  <div class="relative w-full bg-white text-neutral-900 font-sans min-h-screen">
    
    <!-- Top Hero Header Section -->
    <section class="relative w-full px-4 sm:px-6 lg:px-8 pt-10 sm:pt-20 pb-10 sm:pb-16 border-b border-neutral-100">
      <div class="mx-auto max-w-7xl">
        <div class="max-w-3xl">
          <span class="inline-block text-xs font-mono font-semibold uppercase tracking-wider text-neutral-500 mb-3">
            R3ACTR Innovations • Collective
          </span>
          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-neutral-900 leading-[1.1] mb-4 sm:mb-5">
            The <span class="bg-gradient-to-r from-[#d946ef] via-[#ec4899] to-[#f97316] bg-clip-text text-transparent">Squad</span>.
          </h1>
          <p class="text-sm sm:text-lg text-neutral-600 leading-relaxed max-w-2xl">
            A small, relentless team combining product engineering, deep learning workflows, systems architecture, and community leadership.
          </p>
        </div>
      </div>
    </section>

    <!-- Squad Grid Section (Exact Same Aesthetic and Pure Shapes as Founders Section) -->
