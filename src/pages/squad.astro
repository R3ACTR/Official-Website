      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10 sm:gap-14 lg:gap-16">
          
          <!-- 1. Abhinav R (Dark Charcoal Double Curved Shape) -->
