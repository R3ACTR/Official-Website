            <div class="relative w-full aspect-[4/4.5] max-w-[270px] mx-auto overflow-hidden bg-[#3c3e4c] rounded-[52px] flex items-end justify-center group shadow-md transition-transform duration-300 hover:-translate-y-1">
              <div class="absolute -top-10 -left-10 w-28 h-28 rounded-full bg-white/5 pointer-events-none"></div>
              <img
                src="/assets/id/abhinav_nobg.png"
                alt="Abhinav R"
                class="w-full h-full object-contain object-bottom select-none pointer-events-none filter grayscale contrast-110 transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="mt-6 flex flex-col items-center">
              <h2 class="text-xl sm:text-2xl font-bold text-neutral-900 tracking-tight font-sans">
                Abhinav R
              </h2>
              <p class="text-xs sm:text-sm text-neutral-500 mt-1 font-medium">
                Co-Founder & CEO
