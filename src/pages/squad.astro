  <script is:inline>
    function setupModal(openBtnId, modalId, closeBtnId, backdropId) {
      const openBtn = document.getElementById(openBtnId);
      const modal = document.getElementById(modalId);
      const closeBtn = document.getElementById(closeBtnId);
      const backdrop = document.getElementById(backdropId);

      function open() {
        if (!modal) return;
        modal.classList.remove('opacity-0', 'pointer-events-none');
        const card = modal.querySelector('.relative.w-full');
        if (card) {
          card.classList.remove('scale-95');
          card.classList.add('scale-100');
        }
        document.body.style.overflow = 'hidden';
      }

      function close() {
        if (!modal) return;
        modal.classList.add('opacity-0', 'pointer-events-none');
        const card = modal.querySelector('.relative.w-full');
        if (card) {
          card.classList.remove('scale-100');
          card.classList.add('scale-95');
        }
        document.body.style.overflow = '';
      }

      if (openBtn) openBtn.addEventListener('click', open);
      if (closeBtn) closeBtn.addEventListener('click', close);
      if (backdrop) backdrop.addEventListener('click', close);

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal && !modal.classList.contains('pointer-events-none')) {
          close();
        }
      });
    }

    setupModal('open-ceo-modal', 'ceo-modal', 'close-ceo-modal', 'ceo-modal-backdrop');
    setupModal('open-cto-modal', 'cto-modal', 'close-cto-modal', 'cto-modal-backdrop');
    setupModal('open-cpio-modal', 'cpio-modal', 'close-cpio-modal', 'cpio-modal-backdrop');
    setupModal('open-coo-modal', 'coo-modal', 'close-coo-modal', 'coo-modal-backdrop');
    setupModal('open-der-modal', 'der-modal', 'close-der-modal', 'der-modal-backdrop');
    setupModal('open-dcl-modal', 'dcl-modal', 'close-dcl-modal', 'dcl-modal-backdrop');
  </script>
