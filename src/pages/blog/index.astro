---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';

const pageTitle: string = `Blog | ${SITE.title}`;
const metaDescription =
  'R3ACTR blog is coming soon. Stay tuned for insights on AI, Web3, and software engineering.';
const ogTitle = 'Blog | R3ACTR';
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
>
  <div class="flex h-[70vh] items-center justify-center px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <div class="mb-6 inline-flex items-center gap-x-2 rounded-full border border-orange-500/30 bg-orange-500/10 px-4 py-2 text-sm font-bold tracking-widest text-orange-600 dark:border-orange-400/30 dark:bg-orange-400/10 dark:text-orange-400 uppercase">
        <span class="flex h-2 w-2 rounded-full bg-orange-500 animate-pulse"></span>
        Under Construction
      </div>
      
      <h1 class="text-5xl md:text-7xl font-extrabold text-neutral-800 dark:text-neutral-200 tracking-tight mb-6">
        Blog <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-orange-600 dark:from-orange-300 dark:to-orange-500">Coming Soon</span>
      </h1>
      
      <p class="mt-4 text-lg md:text-xl text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto mb-10">
        We're busy engineering momentum. Check back later for deep dives into AI, Web3, scalable SaaS architecture, and open-source development.
      </p>
      
      <a
        href="/"
        class="inline-flex items-center gap-x-2 rounded-full bg-neutral-800 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-all hover:bg-neutral-900 focus:outline-none focus:ring-2 focus:ring-neutral-900 focus:ring-offset-2 dark:bg-white dark:text-neutral-800 dark:hover:bg-neutral-200"
      >
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Return to Home
      </a>
    </div>
  </div>
</MainLayout>
