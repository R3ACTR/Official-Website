---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';
import { blogs } from '@data/blogs';

const pageTitle = `Blog & Insights | ${SITE.title}`;
const metaDescription =
  'Read technical deep dives, engineering insights, and tool spotlights from the R3ACTR team across AI, Web3, and scientific computing.';
const ogTitle = 'Blog & Insights | R3ACTR';

const featuredPost = blogs[0];

---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
>
  <div class="mx-auto max-w-7xl px-4 pt-20 pb-16 sm:px-6 sm:pt-24 lg:px-8 lg:pt-28">
    {/* Header Section */}
    <div class="text-center max-w-3xl mx-auto mb-14 lg:mb-16">

      <h1 class="text-3xl md:text-5xl lg:text-6xl font-extrabold text-neutral-800 dark:text-neutral-200 tracking-tight">
        Engineering <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-orange-600 dark:from-orange-300 dark:to-orange-500">Momentum</span> & Perspectives
      </h1>
      <p class="mt-4 text-base sm:text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-2xl mx-auto">
        Deep dives into developer tooling, scientific authoring, scalable SaaS architecture, and the frontier of AI & Web3.
      </p>
    </div>

    {/* Featured Article Hero Card */}
    <section class="mb-16">
      <div class="relative overflow-hidden rounded-3xl border border-neutral-300 bg-white p-6 sm:p-8 lg:p-10 shadow-sm dark:border-neutral-700 dark:bg-neutral-900 transition-all duration-300 hover:border-neutral-400 dark:hover:border-neutral-600">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          {/* Article Info */}
          <div class="lg:col-span-7 flex flex-col justify-between">
            <div>
              <div class="flex flex-wrap items-center gap-3 text-xs mb-4">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-orange-500 px-3 py-1 font-bold tracking-wider text-white uppercase text-[11px] shadow-sm">
                  ★ Featured Post
                </span>
                <span class="rounded-full border border-orange-500/30 bg-orange-500/10 px-3 py-1 font-semibold text-orange-600 dark:border-orange-400/30 dark:bg-orange-400/10 dark:text-orange-400">
                  {featuredPost.category}
                </span>
                <span class="text-neutral-400 dark:text-neutral-500">•</span>
                <span class="text-neutral-600 dark:text-neutral-400 font-medium">
                  {featuredPost.readTime}
                </span>
              </div>

              <a href={`/blog/${featuredPost.slug}`} class="group block">
                <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100 group-hover:text-orange-500 dark:group-hover:text-orange-400 transition-colors">
                  {featuredPost.title}
                </h2>
              </a>

              <p class="mt-4 text-base sm:text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed">
                {featuredPost.description}
              </p>

              <div class="mt-6 flex flex-wrap gap-2">
                {featuredPost.tags.map((tag) => (
                  <span class="rounded-md bg-neutral-100 px-2.5 py-1 text-xs font-medium text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>

            <div class="mt-8 pt-6 border-t border-neutral-200 dark:border-neutral-800 flex flex-wrap items-center justify-between gap-4">
              <div class="flex items-center gap-x-3">
                <img
                  src={featuredPost.author.avatar}
                  alt={featuredPost.author.name}
                  class="h-10 w-10 rounded-full border border-neutral-300 bg-neutral-100 object-cover dark:border-neutral-700 dark:bg-neutral-800"
                  loading="lazy"
                />
                <div>
                  <p class="text-sm font-bold text-neutral-800 dark:text-neutral-200">
                    {featuredPost.author.name}
                  </p>
                  <p class="text-xs text-neutral-500 dark:text-neutral-400">
                    {featuredPost.pubDate}
                  </p>
                </div>
              </div>

              <a
                href={`/blog/${featuredPost.slug}`}
                class="inline-flex items-center gap-x-2 rounded-full bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:bg-orange-500 dark:bg-white dark:text-neutral-900 dark:hover:bg-orange-500 dark:hover:text-white"
              >
                Read Article
                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>

          {/* Article Image / Illustration */}
          <div class="lg:col-span-5 flex items-center justify-center">
            <a
              href={`/blog/${featuredPost.slug}`}
              class="group relative block w-full overflow-hidden rounded-2xl border border-neutral-200 bg-gradient-to-b from-neutral-50 to-neutral-100 p-6 sm:p-8 dark:border-neutral-800 dark:from-neutral-800/60 dark:to-neutral-900/80"
            >
              <img
                src={featuredPost.coverImage}
                alt={featuredPost.title}
                class="mx-auto max-h-[300px] sm:max-h-[320px] w-auto object-contain transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</MainLayout>
