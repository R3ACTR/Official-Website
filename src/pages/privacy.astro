---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';

const pageTitle: string = `Privacy Policy | ${SITE.title}`;
const metaDescription =
  'Read the Privacy Policy of R3ACTR to understand how we handle data across our platforms, services, and open-source tools.';
const ogTitle = 'Privacy Policy | R3ACTR';

const sections = [
  {
    number: '01',
    title: 'Introduction & Scope',
    content:
      'At R3ACTR ("we", "our", or "us"), we respect your privacy. This policy covers how we handle information across our official website, platforms (including KTU Hub and PaperLab), and associated digital services.',
  },
  {
    number: '02',
    title: 'Information We Collect',
    content:
      'We only collect information necessary to deliver and improve our services: direct contact details submitted via forms (name, email), anonymous performance diagnostics, and non-identifiable usage statistics.',
  },
  {
    number: '03',
    title: 'Local Processing First',
    content:
      'Tools like PaperLab and desktop AI applications prioritize local execution in your browser or device whenever possible. Your document content and datasets remain under your direct control.',
  },
  {
    number: '04',
    title: 'How We Use Information',
    content:
      'Data collected is used strictly to respond to project proposals and contact requests, optimize platform speed and reliability, and publish service updates to subscribed users.',
  },
  {
    number: '05',
    title: 'Data Protection & Sharing',
    content:
      'We implement industry-standard administrative and technical security measures. We do not sell, rent, or trade your personal information to third-party advertisers or data brokers.',
  },
  {
    number: '06',
    title: 'Questions & Contact',
    content:
      'If you have questions regarding our privacy practices or data handling, reach out directly at r3actr@gmail.com or submit an inquiry through our Contact page.',
    isContact: true,
  },
];
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    {/* Header */}
    <div class="text-center max-w-2xl mx-auto mb-10 lg:mb-12">
      <div class="inline-flex items-center gap-x-2 rounded-full border border-orange-500/30 bg-orange-500/10 px-3.5 py-1 text-xs font-bold tracking-widest text-orange-600 dark:border-orange-400/30 dark:bg-orange-400/10 dark:text-orange-400 uppercase mb-3">
        <span class="flex h-1.5 w-1.5 rounded-full bg-orange-500"></span>
        Legal & Compliance
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-neutral-800 dark:text-neutral-200 tracking-tight">
        Privacy <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-orange-600 dark:from-orange-300 dark:to-orange-500">Policy</span>
      </h1>
      <p class="mt-3 text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Understand how we handle, protect, and respect your data across all R3ACTR platforms.
      </p>
    </div>

    {/* Policy Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16 items-stretch">
      {
        sections.map((sec) => (
          <div class="flex flex-col justify-between rounded-2xl border border-neutral-300 bg-white p-5 sm:p-6 dark:border-neutral-700 dark:bg-neutral-900 transition-colors duration-200 hover:border-neutral-400 dark:hover:border-neutral-600">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-mono font-bold text-orange-600 dark:text-orange-400">
                  {sec.number}
                </span>
                <span class="h-1.5 w-1.5 rounded-full bg-neutral-300 dark:bg-neutral-700"></span>
              </div>
              <h2 class="text-lg sm:text-xl font-bold text-neutral-800 dark:text-neutral-200 tracking-tight mb-2">
                {sec.title}
              </h2>
              <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                {sec.content}
              </p>
            </div>

            {sec.isContact && (
              <div class="mt-5 pt-4 border-t border-neutral-200 dark:border-neutral-800 flex items-center gap-3">
                <a
                  href="/contact"
                  class="inline-flex items-center gap-x-1.5 rounded-lg bg-orange-500 px-3.5 py-1.5 text-xs font-bold text-white transition-colors duration-200 hover:bg-orange-600"
                >
                  Contact Us
                  <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
                <a
                  href="mailto:r3actr@gmail.com"
                  class="text-xs font-semibold text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors"
                >
                  r3actr@gmail.com
                </a>
              </div>
            )}
          </div>
        ))
      }
    </div>

    {/* Bottom Callout */}
    <div class="rounded-2xl border border-neutral-300 bg-white p-6 sm:p-8 text-center dark:border-neutral-700 dark:bg-neutral-900">
      <h3 class="text-xl sm:text-2xl font-bold text-neutral-800 dark:text-neutral-200 tracking-tight">
        Have questions regarding data privacy?
      </h3>
      <p class="mt-2 text-neutral-600 dark:text-neutral-400 max-w-lg mx-auto text-xs sm:text-sm">
        Our team is available to answer any questions about our infrastructure, security measures, or data practices.
      </p>
      <div class="mt-4 flex justify-center">
        <a
          href="/contact"
          class="inline-flex items-center gap-x-2 rounded-lg bg-neutral-900 px-6 py-2.5 text-xs sm:text-sm font-bold text-white transition-colors duration-200 hover:bg-neutral-800 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-200"
        >
          Get In Touch
          <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</MainLayout>
