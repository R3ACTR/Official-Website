---
// Destructure the properties from Astro.props
const { title, url } = Astro.props;

// Define TypeScript interface for the properties
interface Props {
  title?: string;
  url?: string;
}
// Define CSS classes for the hyperlink button
const baseClasses =
  'inline-flex items-center justify-center gap-x-2 rounded-xl px-5 py-3 text-center text-sm font-semibold text-slate-200 shadow-xs outline-hidden transition duration-300 active:scale-95';
const borderClasses = 'border border-white/15';
const bgColorClasses = 'bg-[#162744] hover:bg-[#1f375f] hover:text-white';
const hoverClasses =
  'hover:border-white/30';
const disableClasses = 'disabled:pointer-events-none disabled:opacity-50';
const fontSizeClasses = '2xl:text-base';
const ringClasses = 'focus-visible:ring-2 focus-visible:ring-cyan-400';

const darkClasses =
  'dark:border-white/15 dark:bg-[#162744] dark:text-slate-200 dark:hover:bg-[#1f375f] dark:hover:text-white dark:focus:outline-hidden';
---

{/* Styled hyperlink */}
<a
  class={`${baseClasses} ${borderClasses} ${bgColorClasses} ${hoverClasses} ${disableClasses} ${fontSizeClasses} ${ringClasses} ${darkClasses}`}
  href={url}
>
  {title}
</a>
