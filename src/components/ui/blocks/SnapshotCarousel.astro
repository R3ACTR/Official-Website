---
import PerspectiveCarousel from '@/components/ui/perspective-carousel.astro';

const items = [
  {
    src: '/assets/Images/1.jpeg',
    title: 'RunnerUp Genesis',
  },
  { src: '/assets/Images/2.jpeg', title: 'Best Paper ICITIIT' },
  { src: '/assets/Images/3.jpeg', title: 'MOU R3ACTR x SBCE' },
  { src: '/assets/Images/4.jpeg', title: 'MOU R3ACTR x SBCE' },
  { src: '/assets/Images/5.jpeg', title: 'Beginning of R3ACTR' },
  { src: '/assets/Images/6.jpeg', title: 'Research & Applied AI Lab' },
  { src: '/assets/Images/7.jpeg', title: 'Building' },
  { src: '/assets/Images/8.jpeg', title: 'Kerala STartup Summit' },
  { src: '/assets/Images/9.jpeg', title: 'PaperLab Amal Jyothi' },
];
---

<section class="breakout-section overflow-hidden py-14">
  <div
    class="mx-auto mb-8 max-w-[85rem] px-4 text-center sm:mb-10 sm:px-6 lg:px-8"
  >
    <h2
      class="bg-gradient-to-r from-orange-400 to-orange-600 bg-clip-text text-4xl font-extrabold tracking-tight text-transparent md:text-5xl dark:from-orange-300 dark:to-orange-500"
    >
      SNAPSHOTS
    </h2>
    <p class="mt-3 text-base text-neutral-600 sm:text-lg dark:text-neutral-400">
      A glimpse into our recent work, research, and innovations.
    </p>
  </div>

  <div class="mx-auto max-w-7xl px-2 sm:px-4">
    <div
      class="relative rounded-3xl border border-neutral-300/80 bg-neutral-100/60 p-2 shadow-sm backdrop-blur-sm sm:p-4 dark:border-neutral-800 dark:bg-neutral-900/60"
    >
      <PerspectiveCarousel
        items={items}
        defaultActiveIndex={2}
        slideWidth={220}
        rotationStep={55}
        inactiveScale={0.84}
        className="h-[520px] rounded-2xl sm:h-[560px]"
      />
    </div>
  </div>
</section>

<style>
  .breakout-section {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
  }
</style>
