---
import PerspectiveCarousel from '@/components/ui/perspective-carousel.astro';

const items = [
  {
    src: '/assets/Images/1.jpeg',
    title: 'RunnerUp Genesis',
  },
  { src: '/assets/Images/2.jpeg', title: 'Best Paper ICITIIT' },
  { src: '/assets/Images/3.jpeg', title: 'MOU R3ACTR x SBCE' },
  { src: '/assets/Images/4.jpeg', title: 'MOU R3ACTR x SBCE' },
  { src: '/assets/Images/5.jpeg', title: 'Beginning of R3ACTR' },
  { src: '/assets/Images/6.jpeg', title: 'Research & Applied AI Lab' },
  { src: '/assets/Images/7.jpeg', title: 'Building' },
  { src: '/assets/Images/8.jpeg', title: 'Kerala STartup Summit' },
  { src: '/assets/Images/9.jpeg', title: 'PaperLab Amal Jyothi' },
];
---

<section class="breakout-section overflow-hidden py-10 sm:py-14">
  <div
    class="mx-auto mb-6 max-w-[85rem] px-4 text-center sm:mb-10 sm:px-6 lg:px-8"
  >
    <h2
      class="bg-gradient-to-r from-orange-400 to-orange-600 bg-clip-text text-3xl font-extrabold tracking-tight text-transparent sm:text-4xl md:text-5xl dark:from-orange-300 dark:to-orange-500"
    >
      SNAPSHOTS
    </h2>
    <p class="mt-2 text-sm text-slate-300 sm:mt-3 sm:text-base md:text-lg">
      A glimpse into our recent work, research, and innovations.
    </p>
  </div>

  <div class="mx-auto max-w-7xl px-2 sm:px-4">
    <div
      class="relative h-[440px] min-h-[440px] w-full rounded-2xl border border-white/10 bg-[#13233f]/70 p-2 shadow-2xl backdrop-blur-md sm:h-[500px] sm:min-h-[500px] sm:rounded-3xl sm:p-4 md:h-[550px] md:min-h-[550px]"
    >
      <PerspectiveCarousel
        items={items}
        defaultActiveIndex={2}
        slideWidth={220}
        rotationStep={50}
        inactiveScale={0.84}
      />
    </div>
  </div>
</section>

<style>
  .breakout-section {
    width: 100%;
    position: relative;
  }

  @media (min-width: 1280px) {
    .breakout-section {
      width: 100vw;
      left: 50%;
      right: 50%;
      margin-left: -50vw;
      margin-right: -50vw;
    }
  }
</style>
