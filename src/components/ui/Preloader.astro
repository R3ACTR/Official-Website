<style>
  .trace-path {
    fill: transparent;
    stroke: #f97316; /* Tailwind orange-500 */
    stroke-width: 6.5px;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
  }

  @keyframes trace {
    0% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      stroke-dashoffset: 0;
    }
  }

  @keyframes fill-in {
    to {
      fill: #ffffff;
      stroke: transparent;
    }
  }
</style>

<script>
  // Ensure this runs only once when DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    const preloader = document.getElementById('preloader');
    if (!preloader) return;
    
    // Check if we've already shown the preloader in this session
    if (sessionStorage.getItem('r3actr_preloader_shown')) {
      preloader.style.display = 'none';
      return;
    }

    const paths = preloader.querySelectorAll('.trace-path') as NodeListOf<SVGPathElement>;
    
    // Animate paths with exact slow trace
    paths.forEach(path => {
      const length = path.getTotalLength();
      path.style.strokeDasharray = `${length}`;
      path.style.strokeDashoffset = `${length}`;
      
      // Trigger a reflow
      path.getBoundingClientRect();
      
      // Smooth slow trace: 2.2s line draw, then fill in at 1.8s
      path.style.animation = `trace 2.2s ease-in-out forwards, fill-in 0.6s ease-in-out 1.8s forwards`;
    });

    // Fade out and remove preloader after animation completes
    setTimeout(() => {
      preloader.classList.add('opacity-0', 'pointer-events-none');
      setTimeout(() => {
        preloader.remove();
        sessionStorage.setItem('r3actr_preloader_shown', 'true');
      }, 500); // Wait for transition duration
    }, 2800); // 2.2s trace + 0.6s fill
  });
</script>
