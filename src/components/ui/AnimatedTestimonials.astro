---
// AnimatedTestimonials.astro
export interface Testimonial {
  quote: string;
  name: string;
  designation: string;
  src: string;
}

interface Props {
  testimonials: Testimonial[];
}

const { testimonials } = Astro.props;
---

<div class="max-w-6xl mx-auto px-4 md:px-8 py-20 flex flex-col md:flex-row gap-16 items-center justify-between testimonial-container">
  {/* Images Column */}
  <div class="relative w-full md:w-1/2 aspect-square max-w-sm mx-auto">
    {testimonials.map((test, index) => (
      <div 
        class="testimonial-image absolute inset-0 transition-all duration-700 ease-in-out origin-center"
        data-index={index}
      >
        <img 
          src={test.src} 
          alt={test.name} 
          draggable="false"
          class="w-full h-full object-cover rounded-3xl shadow-xl"
        />
      </div>
    ))}
  </div>

  {/* Text Column */}
  <div class="w-full md:w-1/2 flex flex-col gap-8">
    <div class="relative min-h-[250px] md:min-h-[200px]">
      {testimonials.map((test, index) => (
        <div 
          class="testimonial-text absolute inset-0 transition-all duration-700 ease-out opacity-0 translate-y-8 pointer-events-none"
          data-index={index}
        >
          <h3 class="text-3xl md:text-4xl font-extrabold text-neutral-800 dark:text-neutral-200 mb-1">{test.name}</h3>
          <p class="text-sm md:text-base text-neutral-500 dark:text-neutral-400 mb-6 font-medium tracking-wide uppercase">{test.designation}</p>
          <p class="text-xl md:text-2xl text-neutral-700 dark:text-neutral-300 leading-relaxed font-serif">"{test.quote}"</p>
        </div>
      ))}
    </div>

    {/* Controls */}
    <div class="flex gap-4">
      <button class="prev-btn group p-4 rounded-full bg-neutral-100 dark:bg-neutral-800 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-all duration-300 text-neutral-800 dark:text-neutral-200 shadow-sm hover:shadow-md">
        <svg class="w-5 h-5 transition-transform duration-300 group-hover:-translate-x-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button class="next-btn group p-4 rounded-full bg-neutral-100 dark:bg-neutral-800 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-all duration-300 text-neutral-800 dark:text-neutral-200 shadow-sm hover:shadow-md">
        <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const containers = document.querySelectorAll('.testimonial-container');
    
    containers.forEach(container => {
      let currentIndex = 0;
      const images = container.querySelectorAll('.testimonial-image');
      const texts = container.querySelectorAll('.testimonial-text');
      const total = images.length;
      const prevBtn = container.querySelector('.prev-btn');
      const nextBtn = container.querySelector('.next-btn');
      
      // Random deterministic rotations for stacked images
      const rotations = [-4, 5, -6, 4, -3];

      function update() {
        images.forEach((img, i) => {
          const diff = (i - currentIndex + total) % total;
          const el = img as HTMLElement;
          
          if (diff === 0) {
            // Active image
            el.style.zIndex = '30';
            el.style.transform = 'scale(1) rotate(0deg) translate(0, 0)';
            el.style.opacity = '1';
            el.style.filter = 'blur(0px)';
          } else {
            // Stacked images behind
            const rot = rotations[i % rotations.length];
            // The further back, the smaller and lower opacity
            el.style.zIndex = (20 - diff).toString();
            // Create a nice stacked effect
            const scale = 1 - (diff * 0.05);
            const translate = diff * 5; 
            el.style.transform = `scale(${scale}) rotate(${rot}deg) translateY(${translate}%)`;
            el.style.opacity = (1 - diff * 0.2).toString();
            el.style.filter = `blur(${diff}px)`;
          }
        });

        texts.forEach((text, i) => {
          const el = text as HTMLElement;
          if (i === currentIndex) {
            el.classList.remove('opacity-0', 'translate-y-8', 'pointer-events-none');
            el.classList.add('opacity-100', 'translate-y-0');
          } else {
            el.classList.add('opacity-0', 'translate-y-8', 'pointer-events-none');
            el.classList.remove('opacity-100', 'translate-y-0');
          }
        });
      }

      nextBtn?.addEventListener('click', () => {
        currentIndex = (currentIndex + 1) % total;
        update();
      });

      prevBtn?.addEventListener('click', () => {
        currentIndex = (currentIndex - 1 + total) % total;
        update();
      });

      // Initialize
      update();
    });
  });
</script>
