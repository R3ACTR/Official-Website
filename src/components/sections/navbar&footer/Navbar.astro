<!-- CLIENT JAVASCRIPT: Dropdown toggles, modals, sub-nav title contextualization -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {


    // Check Firebase or local cached login user display if present
    const userDisplay = document.getElementById('navbar-user-display');
    const cachedUser = localStorage.getItem('r3actr_user_email');
    if (userDisplay && cachedUser) {
      userDisplay.textContent = cachedUser;
    }

    // Generic Dropdown Toggle Helper
    const setupDropdown = (btnId, menuId) => {
      const btn = document.getElementById(btnId);
      const menu = document.getElementById(menuId);
      if (!btn || !menu) return;

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = menu.classList.contains('hidden');
        // Close other open popovers
        document.querySelectorAll('#globe-dropdown-menu, #notifications-menu, #user-dropdown-menu').forEach(el => {
          if (el !== menu) el.classList.add('hidden');
        });
        if (isHidden) {
          menu.classList.remove('hidden');
        } else {
          menu.classList.add('hidden');
        }
      });
    };

    // Mobile Hamburger Toggle
    const mobileBtn = document.getElementById('mobile-menu-toggle');
    const mobileDrawer = document.getElementById('mobile-drawer');
    if (mobileBtn && mobileDrawer) {
      mobileBtn.addEventListener('click', () => {
        mobileDrawer.classList.toggle('hidden');
      });
    }

    // Modal Helpers
    const setupModal = (triggerIds, modalId, closeId) => {
      const modal = document.getElementById(modalId);
      const closeBtn = document.getElementById(closeId);

      triggerIds.forEach(id => {
        const btn = document.getElementById(id);
        if (btn) {
          btn.addEventListener('click', () => {
            if (modal) {
              modal.classList.remove('hidden');
              modal.classList.add('flex');
              const card = modal.querySelector('.launchpad-modal-card');
              if (card) {
                card.classList.remove('animate-fluent-popup');
                void card.offsetWidth; // trigger reflow
                card.classList.add('animate-fluent-popup');
              }
            }
          });
        }
      });

      if (closeBtn && modal) {
        closeBtn.addEventListener('click', () => {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        });
      }

      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
          }
        });
      }
    };

    // setupModal(['btn-ask-ai', 'btn-ask-ai-mobile'], 'modal-ask-ai', 'close-ask-ai'); // Disabled for now
    setupModal(['btn-launchpad', 'btn-launchpad-mobile'], 'modal-launchpad', 'close-launchpad');

    // Interactive Ask AI behavior
    const promptInput = document.getElementById('ai-prompt-input');
    const sendBtn = document.getElementById('ai-send-btn');
    const responseBox = document.getElementById('ai-response-box');

    const handleAiQuery = (query) => {
      if (!query || !responseBox) return;
      responseBox.classList.remove('hidden');
      responseBox.innerHTML = '<div class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-cyan-600 animate-ping"></span> Thinking...</div>';
      
      setTimeout(() => {
        const lower = query.toLowerCase();
        let answer = "R3ACTR is an innovative engineering collective researching, building, and deploying intelligent software, developer ecosystems, and AI infrastructure.";
        if (lower.includes('paper lab') || lower.includes('paperlab')) {
          answer = "<strong>Paper Lab:</strong> An intelligent academic writing & publishing platform combining WYSIWYG editing with automated LaTeX compilation and Python templates. Try it live at <a href='https://paperlab.r3actr.work/' target='_blank' class='text-blue-600 underline'>paperlab.r3actr.work</a>.";
        } else if (lower.includes('quest') || lower.includes('open source')) {
          answer = "<strong>Open Source Quest:</strong> A month-long contribution program providing guided mentorship on real-world software architecture and repositories. Check out our GitHub at <a href='https://github.com/R3ACTR' target='_blank' class='text-blue-600 underline'>github.com/R3ACTR</a>.";
        } else if (lower.includes('epoq')) {
          answer = "<strong>EPOQ:</strong> A local deep learning GUI and experimentation suite designed to streamline neural network training and evaluation.";
        } else if (lower.includes('custom') || lower.includes('service') || lower.includes('hire')) {
          answer = "<strong>Custom Engineering:</strong> R3ACTR designs bespoke AI systems, web architectures, and high-performance developer tools. Visit our <a href='/services' class='text-blue-600 underline'>Services Page</a> or <a href='/contact' class='text-blue-600 underline'>Contact Us</a>.";
        }
        responseBox.innerHTML = `<p>${answer}</p>`;
      }, 400);
    };

    if (sendBtn && promptInput) {
      sendBtn.addEventListener('click', () => {
        handleAiQuery(promptInput.value.trim());
      });
      promptInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') handleAiQuery(promptInput.value.trim());
      });
    }

    document.querySelectorAll('.ai-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        if (promptInput) {
          promptInput.value = chip.textContent.trim();
          handleAiQuery(chip.textContent.trim());
        }
      });
    });
  });
</script>
