---
// Modern Spaceship-inspired Footer for R3ACTR
import { SITE } from '@data/constants';

const footerColumns = [
  {
    title: 'Products',
    links: [
      { name: 'Paperlab', url: 'https://apps.microsoft.com/detail/9P0XRRPBC34P', external: true },
      { name: 'Open Source Quest', url: 'https://www.opensourcequest.xyz/', external: true },
      { name: 'Dooms Protocol', url: 'https://www.doomsprotocol.xyz/', external: true },
      { name: 'Micro SaaS Tools', url: '/#playground' },
      { name: 'Digital Experiences', url: '/#playground' },
    ],
  },
  {
    title: 'Engineering',
    links: [
      { name: 'Intelligent Systems', url: '/#playground' },
      { name: 'Deep Learning Workflows', url: '/#playground' },
      { name: 'Web Architectures', url: '/#playground' },
      { name: 'LaTeX & Python Engines', url: 'https://apps.microsoft.com/detail/9P0XRRPBC34P', external: true },
      { name: 'Performance Audits', url: '/contact' },
    ],
  },
  {
    title: 'Community',
    links: [
      { name: 'Open Source Hub', url: 'https://github.com/R3ACTR', external: true },
      { name: 'Hackathons & Events', url: '/#playground' },
      { name: 'Collaborative Labs', url: '/#playground' },
      { name: 'Student Fellowships', url: 'https://www.opensourcequest.xyz/', external: true },
      { name: 'Tech Initiatives', url: '/#playground' },
    ],
  },
  {
    title: 'Company',
    links: [
      { name: 'About R3ACTR', url: '/#faq' },
      { name: 'Our Playground', url: '/#playground' },
      { name: 'Blog & Insights', url: '/blog' },
      { name: 'Frequently Asked Questions', url: '/#faq' },
      { name: 'Contact & Support', url: '/contact' },
    ],
  },
  {
    title: 'Legal & Trust',
    links: [
      { name: 'Privacy Policy', url: '/privacy' },
      { name: 'Terms of Service', url: '/terms' },
      { name: 'Security Overview', url: '/privacy' },
      { name: 'Open Source Licensing', url: 'https://github.com/R3ACTR', external: true },
    ],
  },
];
---

<footer class="w-full bg-[#121214] text-neutral-300 border-t border-neutral-800/80 font-sans select-none">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 pt-16 pb-12">
    
    <!-- TOP SECTION: Multi-column Navigation Links -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-8 lg:gap-10 pb-14 border-b border-neutral-800">
      {
        footerColumns.map((col) => (
          <div>
            <h4 class="text-xs font-semibold text-white uppercase tracking-wider mb-4 font-mono">
              {col.title}
            </h4>
            <ul class="space-y-2.5">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.url}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                    class="text-xs sm:text-sm text-neutral-400 hover:text-white transition-colors duration-150 inline-flex items-center gap-1"
                  >
                    <span>{link.name}</span>
                    {link.external && <span class="text-[10px] opacity-60">↗</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- MIDDLE SECTION: LaunchPad India Award / Recognition -->
    <div class="py-8 border-b border-neutral-800 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
      
      <div class="max-w-md">
        <span class="text-xs font-semibold text-white tracking-wide block mb-1">
          #1 Product of the Week at LaunchPad India
        </span>
        <p class="text-xs text-neutral-400">
          Our intelligent documentation workspace, Paperlab, was awarded #1 Product of the Week on LaunchPad India.
        </p>
      </div>

      <!-- LaunchPad India #1 Product of the Week Badge -->
      <div class="shrink-0 flex items-center">
        <a
          href="https://launchpadindia.co/listing/paper-lab"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="#1 Product of the Week"
          style="display:inline-flex;align-items:center;gap:10px;height:60px;box-sizing:border-box;padding:0 18px 0 10px;background:#ffffff;border:2px solid #f97316;border-radius:14px;text-decoration:none;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Inter,sans-serif;box-shadow:0 1px 2px rgba(249,115,22,0.08), 0 8px 20px -10px rgba(249,115,22,0.25);line-height:1;max-width:100%;transition:transform 0.15s ease,box-shadow 0.15s ease;"
          class="hover:scale-[1.02] active:scale-95 hover:shadow-lg"
        >
          <img
            src="/launchpad-logo.png"
            alt="LaunchPad India"
            width="38"
            height="38"
            loading="lazy"
            style="object-fit:contain;display:block;flex:none;"
          />
          <span style="display:inline-flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:4px;line-height:1;text-align:left;">
            <span style="font-size:9px;font-weight:700;letter-spacing:0.16em;color:#78716c;text-transform:uppercase;white-space:nowrap;text-align:left;">#1 PRODUCT OF THE WEEK</span>
            <span style="font-size:21px;font-weight:700;letter-spacing:-0.025em;color:#0f172a;white-space:nowrap;">LaunchPad<span style="color:#f97316;">India</span></span>
          </span>
        </a>
      </div>

    </div>

    <!-- BOTTOM BAR: Copyright, Entity Name & Social Links -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-500">
      
      <!-- Brand & Entity details -->
      <div class="flex items-center gap-3">
        <img
          src="/R3ACTR%20INNOVATIONS%20LLP.svg"
          alt="R3ACTR Innovations LLP"
          class="h-5 w-auto object-contain brightness-200 opacity-70"
          loading="lazy"
        />
        <p>
          © <span id="current-year"></span> R3ACTR Innovations LLP. All rights reserved.
        </p>
      </div>

      <!-- Social Links (Circular Pill Badges matching spaceship reference) -->
      <div class="flex items-center gap-2.5">
        <!-- GitHub -->
        <a
          href="https://github.com/R3ACTR"
          target="_blank"
          rel="noopener noreferrer"
          class="h-8 w-8 rounded-full bg-neutral-900 border border-neutral-800 flex items-center justify-center text-neutral-400 hover:text-white hover:bg-neutral-800 hover:border-neutral-700 transition-all active:scale-95"
          aria-label="GitHub"
        >
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>

        <!-- X (Twitter) -->
        <a
          href="https://x.com/r3actr"
          target="_blank"
          rel="noopener noreferrer"
          class="h-8 w-8 rounded-full bg-neutral-900 border border-neutral-800 flex items-center justify-center text-neutral-400 hover:text-white hover:bg-neutral-800 hover:border-neutral-700 transition-all active:scale-95"
          aria-label="X (formerly Twitter)"
        >
          <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>

        <!-- Instagram -->
        <a
          href="https://instagram.com/r3actr"
          target="_blank"
          rel="noopener noreferrer"
          class="h-8 w-8 rounded-full bg-neutral-900 border border-neutral-800 flex items-center justify-center text-neutral-400 hover:text-white hover:bg-neutral-800 hover:border-neutral-700 transition-all active:scale-95"
          aria-label="Instagram"
        >
          <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>

        <!-- LinkedIn -->
        <a
          href="https://linkedin.com/company/r3actr"
          target="_blank"
          rel="noopener noreferrer"
          class="h-8 w-8 rounded-full bg-neutral-900 border border-neutral-800 flex items-center justify-center text-neutral-400 hover:text-white hover:bg-neutral-800 hover:border-neutral-700 transition-all active:scale-95"
          aria-label="LinkedIn"
        >
          <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </a>
      </div>

    </div>

  </div>

  <script is:inline>
    const el = document.getElementById('current-year');
    if (el) el.textContent = new Date().getFullYear().toString();
  </script>
</footer>

