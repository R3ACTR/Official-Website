---
import { blogs } from '@data/blogs';

const post = blogs[0];
---

<section class="relative mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8">
  {/* Section Heading */}
  <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-12">
    <h2 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-neutral-800 dark:text-neutral-200 tracking-tight">
      Featured Article
    </h2>
    <p class="mt-3 text-sm sm:text-base text-neutral-600 dark:text-neutral-400">
      Deep dives into developer tooling, research workflows, and modern software craft.
    </p>
  </div>

  {/* Featured Post Card */}
  <div class="relative overflow-hidden rounded-3xl border border-neutral-300 bg-white p-6 sm:p-8 lg:p-10 shadow-sm dark:border-neutral-700 dark:bg-neutral-900 transition-all duration-300 hover:border-neutral-400 dark:hover:border-neutral-600">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      {/* Text Info */}
      <div class="lg:col-span-7 flex flex-col justify-between">
        <div>
          <div class="flex flex-wrap items-center gap-3 text-xs mb-4">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-orange-500 px-3 py-1 font-bold tracking-wider text-white uppercase text-[11px] shadow-sm">
              ★ Featured
            </span>
            <span class="rounded-full border border-orange-500/30 bg-orange-500/10 px-3 py-1 font-semibold text-orange-600 dark:border-orange-400/30 dark:bg-orange-400/10 dark:text-orange-400">
              {post.category}
            </span>
            <span class="text-neutral-400 dark:text-neutral-500">•</span>
            <span class="text-neutral-600 dark:text-neutral-400 font-medium">
              {post.readTime}
            </span>
          </div>

          <a href={`/blog/${post.slug}`} class="group block">
            <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100 group-hover:text-orange-500 dark:group-hover:text-orange-400 transition-colors">
              {post.title}
            </h3>
          </a>

          <p class="mt-4 text-sm sm:text-base text-neutral-600 dark:text-neutral-300 leading-relaxed line-clamp-3">
            {post.description}
          </p>

          <div class="mt-5 flex flex-wrap gap-2">
            {post.tags.slice(0, 4).map((tag) => (
              <span class="rounded-md bg-neutral-100 px-2.5 py-1 text-xs font-medium text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
                #{tag}
              </span>
            ))}
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-neutral-200 dark:border-neutral-800 flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-x-3">
            <img
              src={post.author.avatar}
              alt={post.author.name}
              class="h-10 w-10 rounded-full border border-neutral-300 bg-neutral-100 object-cover dark:border-neutral-700 dark:bg-neutral-800"
              loading="lazy"
            />
            <div>
              <p class="text-sm font-bold text-neutral-800 dark:text-neutral-200">
                {post.author.name}
              </p>
              <p class="text-xs text-neutral-500 dark:text-neutral-400">
                {post.pubDate}
              </p>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <a
              href={`/blog/${post.slug}`}
              class="inline-flex items-center gap-x-2 rounded-full bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:bg-orange-500 dark:bg-white dark:text-neutral-900 dark:hover:bg-orange-500 dark:hover:text-white"
            >
              Read Article
              <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      {/* Cover Image Preview */}
      <div class="lg:col-span-5 flex items-center justify-center">
        <a
          href={`/blog/${post.slug}`}
          class="group relative block w-full overflow-hidden rounded-2xl border border-neutral-200 bg-neutral-100 dark:border-neutral-800 dark:bg-neutral-800/60 shadow-sm"
        >
          <img
            src={post.coverImage}
            alt={post.title}
            class="w-full h-auto max-h-[320px] object-cover object-center transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
        </a>
      </div>
    </div>
  </div>

  {/* View all blogs footer link */}
  <div class="mt-8 text-center">
    <a
      href="/blog"
      class="group inline-flex items-center gap-x-2 text-sm font-semibold text-neutral-600 transition-colors hover:text-orange-500 dark:text-neutral-400 dark:hover:text-orange-400"
    >
      <span>Explore all articles & publications</span>
      <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>
</section>
