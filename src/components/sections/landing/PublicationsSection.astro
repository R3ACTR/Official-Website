---
// PublicationsSection.astro

const publications = [
  {
    title: "ADA-XAI: Adaptive Faithfulness-Driven Explainability for Hybrid EVA-02 and Deformable CNNS in Brain Tumor Diagnosis From MRI Images",
    doi: "View DOI: 10.1109/ICITIIT68860.2026.11499683",
    url: "https://doi.org/10.1109/ICITIIT68860.2026.11499683",
    active: true
  },
  {
    title: "CRDA: Cross-Reasoning Disagreement Analysis for Uncertainty Quantification in Hybrid Voice Classification",
    doi: "DOI Coming Soon",
    active: false
  },
  {
    title: "Pixel-Level Supervision for Medical Imaging: A Custom Masked Autoencoder Framework for Renal Pathology Detection",
    doi: "DOI Coming Soon",
    active: false
  }
];
---

<section class="relative mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8">


  {/* Section Heading */}
  <div class="mx-auto mb-12 max-w-2xl text-center lg:mb-16">
    <h2 class="text-4xl md:text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-orange-600 dark:from-orange-300 dark:to-orange-500 tracking-tight">
      Publications
    </h2>
    <p class="mt-4 text-lg text-neutral-600 dark:text-neutral-400">
      Our latest research and peer-reviewed contributions to the scientific community.
    </p>
  </div>

  {/* Grid of Publications */}
  <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {publications.map((pub) => (
      <div class="group relative flex flex-col h-full rounded-[1.5rem] sm:rounded-[2rem] border border-neutral-200/60 bg-white/60 p-5 sm:p-8 shadow-sm backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:border-orange-500/30 hover:shadow-2xl hover:shadow-orange-500/10 dark:border-neutral-700/50 dark:bg-neutral-800/40 dark:hover:border-orange-400/30 dark:hover:shadow-orange-500/5 overflow-hidden">
        
        {/* Subtle inner gradient on hover */}
        <div class="absolute inset-0 bg-gradient-to-br from-orange-500/0 via-transparent to-orange-500/5 opacity-0 transition-opacity duration-300 group-hover:opacity-100 pointer-events-none"></div>

        <div class="relative z-10 flex flex-col h-full">
          <div class="mb-5 sm:mb-6 flex-1">
            <div class="mb-3 sm:mb-4 flex items-center gap-2">
              <span class="flex h-1.5 w-1.5 sm:h-2 sm:w-2 rounded-full bg-orange-500 animate-pulse"></span>
              <span class="text-[10px] sm:text-xs font-bold tracking-widest text-orange-500 uppercase">Research Paper</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-neutral-800 dark:text-neutral-200 leading-snug transition-colors group-hover:text-neutral-900 dark:group-hover:text-white">
              {pub.title}
            </h3>
          </div>
          <div class="mt-auto pt-4">
            {pub.active ? (
              <a
                href={pub.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex w-full sm:w-fit justify-center sm:justify-start items-center gap-x-2 rounded-full border border-orange-500/30 bg-orange-500/10 px-3 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm font-semibold text-orange-600 transition-all hover:bg-orange-500 hover:text-white dark:border-orange-400/30 dark:bg-orange-400/10 dark:text-orange-400 dark:hover:bg-orange-500 dark:hover:text-white text-center break-words"
              >
                <span class="truncate">{pub.doi}</span>
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 flex-shrink-0 transition-transform group-hover:translate-x-0.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
              </a>
            ) : (
              <div class="inline-flex w-full sm:w-fit justify-center sm:justify-start items-center gap-x-2 rounded-full border border-neutral-200 bg-neutral-100 px-3 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm font-medium text-neutral-500 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-400 text-center">
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 opacity-70 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <span class="truncate">{pub.doi}</span>
              </div>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
