---
// PublicationsSection.astro

const publications = [
  {
    title: "Boosted vision transformer ensembles for automatic detection of laryngeal and neurological voice disorders",
    doi: "View Paper",
    url: "https://doi.org/10.1007/s00521-026-12393-5",
    active: true
  },
  {
    title: "ADA-XAI: Adaptive Faithfulness-Driven Explainability for Hybrid EVA-02 and Deformable CNNS in Brain Tumor Diagnosis From MRI Images",
    doi: "View Paper",
    url: "https://doi.org/10.1109/ICITIIT68860.2026.11499683",
    active: true
  },
  {
    title: "CRDA: Cross-Reasoning Disagreement Analysis for Uncertainty Quantification in Hybrid Voice Classification",
    doi: "View Paper",
    url: "https://doi.org/10.1109/ICIET70550.2026.11712867",
    active: true
  }
];
---

<section class="relative mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8">


  {/* Section Heading */}
  <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-12">
    <h2 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
      Publications
    </h2>
    <p class="mt-3 text-sm sm:text-base text-slate-300">
      Our latest research and peer-reviewed contributions to the scientific community.
    </p>
  </div>

  {/* Grid of Publications */}
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {publications.map((pub) => (
      <div class="group relative flex flex-col justify-between h-full rounded-2xl border border-white/10 bg-[#13233f] p-5 sm:p-6 transition-all duration-200 hover:border-cyan-400/40 hover:bg-[#162744] shadow-md">
        <div class="relative flex flex-col h-full justify-between">
          <div class="mb-5 sm:mb-6">
            <div class="mb-3 sm:mb-4 flex items-center gap-2">
              <span class="flex h-1.5 w-1.5 rounded-full bg-cyan-400"></span>
              <span class="text-[10px] sm:text-xs font-bold tracking-widest text-cyan-400 uppercase">Research Paper</span>
            </div>
            <h3 class="text-base sm:text-lg font-bold text-white leading-snug transition-colors group-hover:text-cyan-300">
              {pub.title}
            </h3>
          </div>
          <div class="mt-auto pt-4 border-t border-white/10">
            {pub.active ? (
              <a
                href={pub.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex w-full sm:w-fit justify-center sm:justify-start items-center gap-x-2 rounded-lg bg-orange-500 px-3.5 py-1.5 text-xs sm:text-sm font-semibold text-white transition-colors duration-200 hover:bg-orange-600 text-center break-words"
              >
                <span class="truncate">{pub.doi}</span>
                <svg class="w-3.5 h-3.5 flex-shrink-0 transition-transform duration-200 group-hover:translate-x-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
              </a>
            ) : (
              <div class="inline-flex w-full sm:w-fit justify-center sm:justify-start items-center gap-x-2 rounded-lg border border-neutral-300 bg-neutral-100 px-3.5 py-1.5 text-xs sm:text-sm font-medium text-neutral-600 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-400 text-center">
                <svg class="w-3.5 h-3.5 opacity-70 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <span class="truncate">{pub.doi}</span>
              </div>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
