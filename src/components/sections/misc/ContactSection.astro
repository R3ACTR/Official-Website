---
import Icon from '@components/ui/icons/Icon.astro';

// Define the variables that will be used in this component
const subTitle: string =
  "Have questions, partnership inquiries, or want to discuss a project? Reach out directly through any of our channels.";
---

{/* Contact Us */}
<section class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
  <div class="mx-auto max-w-2xl lg:max-w-4xl">
    {/* Header */}
    <div class="text-center">
      <h1
        class="text-3xl font-extrabold tracking-tight text-neutral-900 sm:text-5xl dark:text-neutral-50"
      >
        Get in <span class="text-orange-500 dark:text-orange-400">Touch</span>
      </h1>
      <p class="mt-3 text-base text-neutral-600 sm:text-lg dark:text-neutral-400">
        {subTitle}
      </p>
    </div>

    {/* Contact Channels Grid */}
    <div class="mt-12 sm:mt-16 grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-8">
      {/* Email Card */}
      <a
        href="mailto:r3actr@gmail.com"
        class="group relative p-6 sm:p-8 rounded-3xl bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 hover:border-orange-500/60 dark:hover:border-orange-500/60 shadow-sm hover:shadow-xl hover:shadow-orange-500/10 transition-all duration-200 flex flex-col justify-between"
      >
        <div>
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-orange-500/10 text-orange-600 dark:text-orange-400 border border-orange-500/20 mb-5">
            <Icon name="envelopeOpen" />
          </div>
          <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors">
            Email Us
          </h2>
          <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Drop us an email for general inquiries, project proposals, or collaboration opportunities.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-neutral-200 dark:border-neutral-800 flex items-center justify-between text-sm font-semibold text-orange-600 dark:text-orange-400">
          <span>r3actr@gmail.com</span>
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </div>
      </a>

      {/* Office & Headquarters */}
      <div
        class="relative p-6 sm:p-8 rounded-3xl bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 shadow-sm flex flex-col justify-between"
      >
        <div>
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-orange-500/10 text-orange-600 dark:text-orange-400 border border-orange-500/20 mb-5">
            <Icon name="mapPin" />
          </div>
          <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">
            Headquarters
          </h2>
          <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Operating from Kerala, India, building systems and intelligent software for the global developer ecosystem.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-neutral-200 dark:border-neutral-800 text-sm font-semibold text-neutral-700 dark:text-neutral-300">
          Kerala, India
        </div>
      </div>

      {/* FAQ & Support */}
      <a
        href="/faq"
        class="group relative p-6 sm:p-8 rounded-3xl bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 hover:border-orange-500/60 dark:hover:border-orange-500/60 shadow-sm hover:shadow-xl hover:shadow-orange-500/10 transition-all duration-200 flex flex-col justify-between"
      >
        <div>
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-orange-500/10 text-orange-600 dark:text-orange-400 border border-orange-500/20 mb-5">
            <Icon name="chatBubble" />
          </div>
          <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors">
            Frequently Asked Questions
          </h2>
          <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Find immediate answers to common questions about our research, tooling, programs, and engagement models.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-neutral-200 dark:border-neutral-800 flex items-center justify-between text-sm font-semibold text-orange-600 dark:text-orange-400">
          <span>Explore FAQ</span>
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </div>
      </a>

      {/* Core Team ID Registry */}
      <a
        href="/id"
        class="group relative p-6 sm:p-8 rounded-3xl bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 hover:border-orange-500/60 dark:hover:border-orange-500/60 shadow-sm hover:shadow-xl hover:shadow-orange-500/10 transition-all duration-200 flex flex-col justify-between"
      >
        <div>
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-orange-500/10 text-orange-600 dark:text-orange-400 border border-orange-500/20 mb-5">
            <Icon name="question" />
          </div>
          <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors">
            Core Team & Personnel
          </h2>
          <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Verify official credentials, leadership roles, and connect directly with our founders and core leads.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-neutral-200 dark:border-neutral-800 flex items-center justify-between text-sm font-semibold text-orange-600 dark:text-orange-400">
          <span>View Team ID Registry</span>
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </div>
      </a>
    </div>
  </div>
</section>
